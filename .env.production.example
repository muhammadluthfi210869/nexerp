# ═══════════════════════════════════════════════
#  NexERP Production — Environment Variables
# ═══════════════════════════════════════════════
# Copy ke .env.production dan isi nilainya:
#   cp .env.production.example .env.production
#
# Untuk GitHub Actions, set sebagai Repository Secrets:
#   Settings → Secrets and variables → Actions
# ═══════════════════════════════════════════════

# ── Domain ──
DOMAIN_NAME=nexerp.id

# ── Database ──
DB_USER=erp_user
DB_PASSWORD=change-this-to-strong-password
DB_NAME=erp_database

# ── JWT (WAJIB diubah!) ──
JWT_SECRET=generate-with-openssl-rand-64-hex

# ── AES ──
AES_SECRET_KEY=aureon_erp_v4_ultra_secret_key_32

# ── CORS ──
CORS_ORIGIN=https://nexerp.id

# ── Google Sheets / Toribio (opsional) ──
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_CLIENT_EMAIL=
TORIBIO_SPREADSHEET_ID=1J1sdzYNVThhUGanHyYWETH6Lr3dlT77ckKZ5d89OEvU
TORIBIO_REFRESH_INTERVAL_MS=60000

# ═══════════════════════════════════════════════
#  GitHub Actions Secrets (Settings → Secrets)
# ═══════════════════════════════════════════════
#
# VPS_HOST         = IP server (contoh: 5.223.80.88)
# VPS_USER         = Username SSH (contoh: root)
# VPS_SSH_KEY      = Private SSH key (isi file id_rsa)
# VPS_KNOWN_HOSTS  = Output dari: ssh-keyscan <IP>
# VPS_PORT         = Port SSH (default: 22)
# DOMAIN_NAME      = Sama seperti di atas
# DB_USER          = Sama seperti di atas
# DB_NAME          = Sama seperti di atas
# ═══════════════════════════════════════════════
