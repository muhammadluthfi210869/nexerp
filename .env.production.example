# ═══════════════════════════════════════════════
#  NexERP — Environment Variables
# ═══════════════════════════════════════════════
#  FILE INI SAMA PERSIS di lokal dan server.
#  Nilainya boleh beda (isi secret masing-masing).
#
#  Cara pakai:
#    1. cp .env.production.example .env
#    2. Isi semua nilai (wajib: JWT_SECRET)
#    3. Lokal:  docker compose up --build
#    4. Server: docker compose --profile server up -d --build
# ═══════════════════════════════════════════════

# ── Domain (hanya dipakai server untuk nginx/SSL) ──
DOMAIN_NAME=nexerp.id

# ── Database ──
DB_USER=erp_user
DB_PASSWORD=change-this-to-strong-password
DB_NAME=erp_database

# ── JWT (WAJIB diubah! minimal 32 karakter) ──
JWT_SECRET=generate-dengan-openssl-rand-64-hex
JWT_EXPIRES_IN=60m

# ── AES ──
AES_SECRET_KEY=aureon_erp_v4_ultra_secret_key_32

# ── CORS ──
# Lokal: http://localhost:3000
# Server: https://nexerp.id
CORS_ORIGIN=http://localhost:3000

# ── Frontend API URL ──
# Lokal: http://localhost:3001
# Server: https://${DOMAIN_NAME}/api
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Google Sheets / Toribio (opsional) ──
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_CLIENT_EMAIL=
TORIBIO_SPREADSHEET_ID=1J1sdzYNVThhUGanHyYWETH6Lr3dlT77ckKZ5d89OEvU
TORIBIO_REFRESH_INTERVAL_MS=60000

# Kommo CRM
# Bisa "dreamlabofficial" atau "https://dreamlabofficial.kommo.com/"
KOMMO_SUBDOMAIN=dreamlabofficial
# Isi salah satu. Disarankan token berumur panjang dari Kommo.
TOKEN_BERUMUR_PANJANG=
KOMMO_LONG_LIVED_TOKEN=
KOMMO_API_TOKEN=
KOMMO_AUTO_PULL_ENABLED=true
KOMMO_AUTO_PULL_INTERVAL_MS=300000

# ── Port (default sudah aman, ganti jika bentrok) ──
# BACKEND_PORT=3001
# FRONTEND_PORT=3000
