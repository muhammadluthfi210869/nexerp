# ═══════════════════════════════════════════════
#  NexERP — Environment Variables
# ═══════════════════════════════════════════════
#  FILE INI SAMA PERSIS di lokal dan server.
#  Nilainya boleh beda (isi secret masing-masing).
#
#  Cara pakai:
#    1. cp .env.production.example .env
#    2. Isi semua nilai (wajib: JWT_SECRET)
#    3. Lokal:  docker compose up --build
#    4. Server: docker compose --profile server up -d --build
# ═══════════════════════════════════════════════

# ── Domain (hanya dipakai server untuk nginx/SSL) ──
DOMAIN_NAME=nexerp.id

# ── Database ──
DB_USER=erp_user
DB_PASSWORD=change-this-to-strong-password
DB_NAME=erp_database

# ── JWT (WAJIB diubah! minimal 32 karakter) ──
JWT_SECRET=generate-dengan-openssl-rand-64-hex
JWT_EXPIRES_IN=60m

# ── AES ──
AES_SECRET_KEY=aureon_erp_v4_ultra_secret_key_32

# ── CORS ──
# Lokal: http://localhost:3000
# Server: https://nexerp.id
CORS_ORIGIN=http://localhost:3000

# ── Frontend API URL ──
# Lokal: http://localhost:3001
# Server: https://${DOMAIN_NAME}/api
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Google Sheets / Toribio (opsional) ──
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_CLIENT_EMAIL=
TORIBIO_SPREADSHEET_ID=1J1sdzYNVThhUGanHyYWETH6Lr3dlT77ckKZ5d89OEvU
TORIBIO_REFRESH_INTERVAL_MS=60000

# Kommo CRM
# Bisa "dreamlabofficial" atau "https://dreamlabofficial.kommo.com/"
KOMMO_SUBDOMAIN=dreamlabofficial
# Isi salah satu. Disarankan token berumur panjang dari Kommo.
TOKEN_BERUMUR_PANJANG=
KOMMO_LONG_LIVED_TOKEN=
KOMMO_API_TOKEN=
KOMMO_AUTO_PULL_ENABLED=true
KOMMO_AUTO_PULL_INTERVAL_MS=300000

# ── WhatsApp Cloud API (Meta) ──────────────────────────────────────────
# Setup di developers.facebook.com → App "NEXERP TRACK CLIENT" → WhatsApp → API Setup
# WA_BUSINESS_PHONE       : nomor sakral yang didaftarkan ke API (format 6281xxxxxxxxx)
# WA_WEBHOOK_VERIFY_TOKEN : harus SAMA PERSIS dengan "Verifikasi token" di form webhook Meta
# WA_PHONE_NUMBER_ID      : dari tab API Setup (angka)
# WA_WABA_ID              : dari tab API Setup (angka)
# WA_ACCESS_TOKEN         : token permanen dari System User (Business Settings → Users → System users)
WA_BUSINESS_PHONE=
WA_WEBHOOK_VERIFY_TOKEN=dreamlab_secret_2026
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_ACCESS_TOKEN=
# Dedup lead orphan (pesan tanpa tracking code) — jendela penggabungan per nomor, default 7 hari
ORPHAN_DEDUP_WINDOW_MS=604800000

# ── AI Extraction (Fase 3.1) — provider swappable ──
# openai:   LLM_BASE_URL=https://api.openai.com/v1,  LLM_MODEL=gpt-4o-mini
# deepseek: LLM_BASE_URL=https://api.deepseek.com/v1, LLM_MODEL=deepseek-chat
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Port (default sudah aman, ganti jika bentrok) ──
# BACKEND_PORT=3001
# FRONTEND_PORT=3000

# ── Sentry (Error Monitoring) ──────────────────────────────────────────
# SANGAT disarankan. Kosongkan untuk menonaktifkan (SDK jadi no-op).
# Ambil DSN di: sentry.io → Settings → Projects → (project) → Client Keys (DSN)
#  - SENTRY_DSN          : dipakai backend + server/edge frontend.
#  - NEXT_PUBLIC_SENTRY_DSN : dipakai browser (boleh sama dengan SENTRY_DSN).
# SENTRY_AUTH_TOKEN/ORG/PROJECT hanya untuk upload sourcemap saat build
# (opsional). Tanpa token, upload sourcemap otomatis dilewati.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
