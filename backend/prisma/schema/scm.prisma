model GoodsRequirement {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  salesOrderId String   @db.Uuid
  date         DateTime
  notes        String?
  status       String   @default("DRAFT")
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items GoodsRequirementItem[]

  @@map("goods_requirements")
}

model GoodsRequirementItem {
  id            String  @id @default(uuid()) @db.Uuid
  requirementId String  @db.Uuid
  materialId    String  @db.Uuid
  qty           Decimal @db.Decimal(15, 2)
  notes         String?

  requirement GoodsRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@map("goods_requirement_items")
}
