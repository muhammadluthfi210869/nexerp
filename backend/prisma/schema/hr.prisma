model Employee {
  id                  String       @id @default(uuid()) @db.Uuid
  userId              String?      @unique @db.Uuid
  name                String
  // Identity & Demographics
  nik                 String?      @unique
  birthDate           DateTime?
  gender              String? // L / P
  religion            String?
  maritalStatus       String? // SINGLE / MARRIED / DIVORCED / WIDOWED
  // Contact
  phone               String?
  address             String?
  emergencyContact    String?
  emergencyPhone      String?
  // Legal & Finance
  npwp                String?
  bpjsKesehatan       String?
  bpjsKetenagakerjaan String?
  bankName            String?
  bankAccount         String?
  bankHolder          String?
  // Education
  education           String? // SD / SMP / SMA / D3 / S1 / S2
  major               String?
  // Salary & Contract
  baseSalary              String? // Encrypted (AES-256-GCM)
  positionAllowance       String? // Encrypted
  transportFlat           String? // Encrypted
  transportTentativeDaily String? // Encrypted
  onboardingStatus        String   @default("COMPLETED") // IN_PROGRESS | COMPLETED
  totalTrainingHours      Float    @default(0)
  joinedAt                DateTime
  contractEnd             DateTime?
  contractType            ContractType @default(CONTRACT)
  resignDate              DateTime?
  resignReason            String?
  isActive                Boolean      @default(true)
  // Reporting structure
  managerId               String?      @db.Uuid
  // Timestamps
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  user         User?                 @relation(fields: [userId], references: [id])
  manager      Employee?             @relation("EmployeeManagerRelation", fields: [managerId], references: [id])
  subordinates Employee[]            @relation("EmployeeManagerRelation")
  roles        EmployeeRoleMapping[]
  kpiScores    KpiScore[]
  kpiPointLogs KpiPointLog[]
  attendances  Attendance[]
  tickets      Ticket[]
  payrollItems PayrollItem[]
  trainings    EmployeeTraining[]
  loans        EmployeeLoan[]

  @@map("employees")
}

model EmployeeRoleMapping {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @db.Uuid
  division   Division
  roleName   String
  weight     Decimal  @db.Decimal(3, 2) // e.g., 0.80 for 80%
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_role_mappings")
}

model KpiMetricDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  eventCode   String   @unique // e.g., SO_PAID, QC_REJECT
  label       String
  points      Float // e.g., 10 or -5
  division    Division
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("kpi_metric_definitions")
}

model KpiPointLog {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid
  metricCode String
  points     Float

  // Explicit Foreign Keys for standard relational integrity
  soId      String? @db.Uuid
  planId    String? @db.Uuid
  qcAuditId String? @db.Uuid

  salesOrder SalesOrder?     @relation(fields: [soId], references: [id])
  prodPlan   ProductionPlan? @relation(fields: [planId], references: [id])
  qcAudit    QCAudit?        @relation(fields: [qcAuditId], references: [id])

  metadata  Json? // Contextual data
  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("kpi_point_logs")
}

model KpiScore {
  id              String          @id @default(uuid()) @db.Uuid
  employeeId      String          @db.Uuid
  periodId        String          @db.Uuid
  period          FinancialPeriod @relation(fields: [periodId], references: [id])
  finalScore      Float
  subjectiveScore Float? // The 30% part
  objectiveScore  Float? // The 70% part
  metricsData     Json
  createdAt       DateTime        @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, periodId])
  @@map("kpi_scores")
}

model Attendance {
  id                  String           @id @default(uuid()) @db.Uuid
  employeeId          String           @db.Uuid
  clockIn             DateTime
  clockOut            DateTime?
  lat                 Float
  lng                 Float
  distanceFromFactory Float // In meters
  photoPath           String?
  status              AttendanceStatus @default(ON_TIME)
  createdAt           DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("attendances")
}

model Ticket {
  id             String       @id @default(uuid()) @db.Uuid
  employeeId     String       @db.Uuid
  type           TicketType
  status         TicketStatus @default(PENDING)
  reason         String
  startDate      DateTime
  endDate        DateTime?
  amount         String? // Encrypted (for Reimbursement)
  attachmentPath String?
  authorizedById String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  approver User?    @relation("TicketApprover", fields: [authorizedById], references: [id])

  @@map("tickets")
}

model Payroll {
  id                String          @id @default(uuid()) @db.Uuid
  periodId          String          @db.Uuid
  period            FinancialPeriod @relation(fields: [periodId], references: [id])
  status            PayrollStatus   @default(DRAFT)
  totalDisbursement String? // Encrypted total
  authorizedById    String?         @db.Uuid
  authorizedAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  approver User?         @relation("PayrollApprover", fields: [authorizedById], references: [id])
  items    PayrollItem[]

  @@map("payrolls")
}

model PayrollItem {
  id                 String   @id @default(uuid()) @db.Uuid
  payrollId          String   @db.Uuid
  employeeId         String   @db.Uuid
  baseSalary         String // Encrypted
  positionAllowance  String? // Encrypted
  transportFlat      String? // Encrypted
  transportTentative String? // Encrypted
  overtimePay        String? // Encrypted
  kpiIncentive       String // Encrypted
  loanDeduction      String? // Encrypted
  remainingLoan      String? // Encrypted
  bpjsHealth         String? // Encrypted
  bpjsEmployment     String? // Encrypted
  pph21              String? // Encrypted
  deductions         String // Encrypted
  netSalary          String // Encrypted
  notes              String?
  createdAt          DateTime @default(now())

  payroll  Payroll  @relation(fields: [payrollId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("payroll_items")
}

model Candidate {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  department      String
  email           String
  phone           String?
  cvUrl           String?
  cvReviewScore   Float?
  cvReviewNotes   String?
  stage           String   @default("SCREENING") // SCREENING | HR_INTERVIEW | USER_INTERVIEW | OFFERING | DONE | REJECTED
  status          String   @default("IN_PROCESS") // IN_PROCESS | PASSED | REJECTED
  durationDays    Int      @default(0)
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("candidates")
}

model EmployeeTraining {
  id             String   @id @default(uuid()) @db.Uuid
  employeeId     String   @db.Uuid
  trainingType   String
  hours          Float
  goal           String
  trainingDate   DateTime
  certificateUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_trainings")
}

model EmployeeLoan {
  id               String   @id @default(uuid()) @db.Uuid
  employeeId       String   @db.Uuid
  totalAmount      Decimal  @db.Decimal(15, 2)
  monthlyDeduction Decimal  @db.Decimal(15, 2)
  remainingBalance Decimal  @db.Decimal(15, 2)
  reason           String?
  status           String   @default("ACTIVE") // ACTIVE | PAID_OFF
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_loans")
}
