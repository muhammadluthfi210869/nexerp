// ⚠️ PRODUCTION-LIGHT: HR models simplified — removed cross-schema
//    relations to SalesOrder, ProductionPlan, QCAudit, FinancialPeriod
//    since those modules are archived. Restore via PRODUCTION_LIGHT.md.

model Employee {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String?      @unique @db.Uuid
  name            String
  nik             String?      @unique
  birthDate       DateTime?
  gender          String?
  religion        String?
  maritalStatus   String?
  phone           String?
  address         String?
  emergencyContact  String?
  emergencyPhone    String?
  npwp            String?
  bpjsKesehatan   String?
  bpjsKetenagakerjaan String?
  bankName        String?
  bankAccount     String?
  bankHolder      String?
  education       String?
  major           String?
  baseSalary      String?
  joinedAt        DateTime
  contractEnd     DateTime?
  contractType    ContractType @default(CONTRACT)
  resignDate      DateTime?
  resignReason    String?
  isActive        Boolean      @default(true)
  managerId       String?      @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User?                 @relation(fields: [userId], references: [id])
  manager         Employee?             @relation("EmployeeManagerRelation", fields: [managerId], references: [id])
  subordinates    Employee[]            @relation("EmployeeManagerRelation")
  roles           EmployeeRoleMapping[]
  kpiScores       KpiScore[]
  kpiPointLogs    KpiPointLog[]
  attendances     Attendance[]
  tickets         Ticket[]
  payrollItems    PayrollItem[]

  @@map("employees")
}

model EmployeeRoleMapping {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @db.Uuid
  division   Division
  roleName   String
  weight     Decimal  @db.Decimal(3, 2)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("employee_role_mappings")
}

model KpiMetricDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  eventCode   String   @unique
  label       String
  points      Float
  division    Division
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("kpi_metric_definitions")
}

model KpiPointLog {
  id         String @id @default(uuid()) @db.Uuid
  employeeId String @db.Uuid
  metricCode String
  points     Float

  soId      String? @db.Uuid
  planId    String? @db.Uuid
  qcAuditId String? @db.Uuid

  // ⚠️ Relations removed in production-light (SalesOrder, ProductionPlan, QCAudit archived)
  // salesOrder SalesOrder?     @relation(fields: [soId], references: [id])
  // prodPlan   ProductionPlan? @relation(fields: [planId], references: [id])
  // qcAudit    QCAudit?        @relation(fields: [qcAuditId], references: [id])

  metadata  Json?
  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("kpi_point_logs")
}

model KpiScore {
  id              String   @id @default(uuid()) @db.Uuid
  employeeId      String   @db.Uuid
  periodId        String   @db.Uuid
  // ⚠️ period FinancialPeriod @relation(fields: [periodId], references: [id]) — removed
  finalScore      Float
  subjectiveScore Float?
  objectiveScore  Float?
  metricsData     Json
  createdAt       DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, periodId])
  @@map("kpi_scores")
}

model Attendance {
  id                  String           @id @default(uuid()) @db.Uuid
  employeeId          String           @db.Uuid
  clockIn             DateTime
  clockOut            DateTime?
  lat                 Float
  lng                 Float
  distanceFromFactory Float
  photoPath           String?
  status              AttendanceStatus @default(ON_TIME)
  createdAt           DateTime         @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("attendances")
}

model Ticket {
  id             String       @id @default(uuid()) @db.Uuid
  employeeId     String       @db.Uuid
  type           TicketType
  status         TicketStatus @default(PENDING)
  reason         String
  startDate      DateTime
  endDate        DateTime?
  amount         String?
  attachmentPath String?
  authorizedById String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  approver User?    @relation("TicketApprover", fields: [authorizedById], references: [id])

  @@map("tickets")
}

model Payroll {
  id                String          @id @default(uuid()) @db.Uuid
  periodId          String          @db.Uuid
  // ⚠️ period FinancialPeriod @relation(fields: [periodId], references: [id]) — removed
  status            PayrollStatus   @default(DRAFT)
  totalDisbursement String?
  authorizedById    String?         @db.Uuid
  authorizedAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  approver User?         @relation("PayrollApprover", fields: [authorizedById], references: [id])
  items    PayrollItem[]

  @@map("payrolls")
}

model PayrollItem {
  id           String   @id @default(uuid()) @db.Uuid
  payrollId    String   @db.Uuid
  employeeId   String   @db.Uuid
  baseSalary   String
  kpiIncentive String
  deductions   String
  netSalary    String
  createdAt    DateTime @default(now())

  payroll  Payroll  @relation(fields: [payrollId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("payroll_items")
}

model FinancialPeriod {
  id         String       @id @default(uuid()) @db.Uuid
  label      String       @unique
  startDate  DateTime
  endDate    DateTime
  status     PeriodStatus @default(OPEN)

  @@map("financial_periods")
}