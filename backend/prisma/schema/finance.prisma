model Invoice {
  id                String          @id @default(uuid()) @db.Uuid
  invoiceNumber     String          @unique
  category          InvoiceCategory
  type              InvoiceType     @default(FINAL_PAYMENT)
  status            InvoiceStatus   @default(UNPAID)
  amountDue         Decimal         @db.Decimal(15, 2)
  outstandingAmount Decimal         @db.Decimal(15, 2)
  issuedAt          DateTime        @default(now())
  dueDate           DateTime
  paidAt            DateTime?
  soId              String?         @db.Uuid
  poId              String?         @db.Uuid
  workOrderId       String?         @db.Uuid
  deliveryOrderId   String?         @unique @db.Uuid
  supplierId        String?         @db.Uuid
  attachmentUrls    String[]        @default([])
  notes             String?
  description       String?
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  so                SalesOrder?     @relation(fields: [soId], references: [id])
  po                PurchaseOrder?  @relation(fields: [poId], references: [id])
  supplier          Supplier?       @relation(fields: [supplierId], references: [id])
  workOrder         WorkOrder?      @relation(fields: [workOrderId], references: [id])
  deliveryOrder     DeliveryOrder?  @relation("DeliveryOrderInvoice", fields: [deliveryOrderId], references: [id])
  payments          Payment[]
  journalEntries    JournalEntry[]

  @@index([soId, status])
  @@map("unified_invoices")
}

model Account {
  id                    String            @id @default(uuid()) @db.Uuid
  code                  String            @unique
  name                  String
  isActive              Boolean           @default(true)
  type                  AccountType
  normalBalance         NormalBalance
  parentId              String?           @db.Uuid
  reclassifyToAccountId String?           @db.Uuid
  reportGroup           ReportGroup?      @default(OTHER_EXPENSE)
  parent                Account?          @relation("AccountTree", fields: [parentId], references: [id])
  children              Account[]         @relation("AccountTree")
  reclassifyToAccount   Account?          @relation("Reclassification", fields: [reclassifyToAccountId], references: [id])
  reclassifiedFrom      Account[]         @relation("Reclassification")
  journalLines          JournalLine[]
  taxLines              JournalLine[]     @relation("TaxAccount")
  goodsInventory        MaterialItem[]    @relation("InventoryAccount")
  goodsSales            MaterialItem[]    @relation("SalesAccount")
  paymentAccounts       Payment[]         @relation("PaymentAccount")
  lossAccounts          RejectExecution[] @relation("LossAccount")
  adjustmentAccounts    StockAdjustment[] @relation("AdjustmentAccount")

  @@map("accounts")
}

model FinancialPeriod {
  id             String                   @id @default(uuid()) @db.Uuid
  name           String                   @unique
  startDate      DateTime
  endDate        DateTime
  status         PeriodStatus             @default(OPEN)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  summaryLedgers FinancialSummaryLedger[]
  payrolls       Payroll[]
  kpiScores      KpiScore[]

  @@map("financial_periods")
}

model StockAdjustment {
  id             String                @id @default(uuid()) @db.Uuid
  date           DateTime              @default(now())
  warehouseId    String                @db.Uuid
  type           String
  accountId      String                @db.Uuid
  notes          String?
  items          StockAdjustmentItem[]
  account        Account               @relation("AdjustmentAccount", fields: [accountId], references: [id])
  warehouse      Warehouse             @relation(fields: [warehouseId], references: [id])
  journalEntries JournalEntry[]

  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id           String          @id @default(uuid()) @db.Uuid
  adjustmentId String          @db.Uuid
  materialId   String          @db.Uuid
  qty          Decimal         @db.Decimal(15, 2)
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id])
  material     MaterialItem    @relation(fields: [materialId], references: [id])

  @@map("stock_adjustment_items")
}

model JournalEntry {
  id                 String              @id @default(uuid()) @db.Uuid
  date               DateTime
  reference          String?
  description        String
  attachmentUrls     String[]
  sourceDocumentType SourceDocumentType?

  // Explicit Foreign Keys for standard relational integrity
  soId             String? @db.Uuid
  poId             String? @db.Uuid
  paymentId        String? @db.Uuid
  adjustmentId     String? @db.Uuid
  returnId         String? @db.Uuid
  purchaseReturnId String? @db.Uuid
  planId           String? @db.Uuid
  requisitionId    String? @db.Uuid
  invoiceId        String? @db.Uuid
  billId           String? @db.Uuid
  salesInvoiceId   String? @db.Uuid

  salesOrder       SalesOrder?          @relation(fields: [soId], references: [id])
  purchaseOrder    PurchaseOrder?       @relation(fields: [poId], references: [id])
  payment          Payment?             @relation("PaymentToJournal", fields: [paymentId], references: [id])
  stockAdjustment  StockAdjustment?     @relation(fields: [adjustmentId], references: [id])
  salesReturn      SalesReturn?         @relation(fields: [returnId], references: [id])
  purchaseReturn   PurchaseReturn?      @relation(fields: [purchaseReturnId], references: [id])
  productionPlan   ProductionPlan?      @relation(fields: [planId], references: [id])
  requisition      MaterialRequisition? @relation(fields: [requisitionId], references: [id])
  invoice          Invoice?             @relation(fields: [invoiceId], references: [id])
  bill             Bill?                @relation("BillJournalEntries", fields: [billId], references: [id])
  salesInvoice     SalesInvoice?        @relation("SalesInvoiceJournalEntries", fields: [salesInvoiceId], references: [id])
  stockOpnames     StockOpname[]
  copqRecords      COPQRecord[]
  bankTransactions BankTransaction[]
  lines            JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id           String       @id @default(uuid()) @db.Uuid
  journalId    String       @db.Uuid
  accountId    String       @db.Uuid
  debit        Decimal      @default(0) @db.Decimal(15, 2)
  credit       Decimal      @default(0) @db.Decimal(15, 2)
  taxAccountId String?      @db.Uuid
  taxRate      Decimal      @default(0) @db.Decimal(5, 2)
  account      Account      @relation(fields: [accountId], references: [id])
  journal      JournalEntry @relation(fields: [journalId], references: [id], onDelete: Cascade)
  taxAccount   Account?     @relation("TaxAccount", fields: [taxAccountId], references: [id])

  @@map("journal_lines")
}

// DEPRECATED: Replaced by unified Invoice
// model Invoice { ... }
// model Bill { ... }

model Payment {
  id                 String         @id @default(uuid()) @db.Uuid
  invoiceId          String         @db.Uuid
  verifiedBy         String         @db.Uuid
  amountPaid         Decimal        @db.Decimal(15, 2)
  paymentDate        DateTime       @default(now())
  receiptFileUrl     String?
  receivingAccountId String?        @db.Uuid
  attachmentUrls     String[]
  deletedAt          DateTime?
  invoice            Invoice        @relation(fields: [invoiceId], references: [id])
  receivingAccount   Account?       @relation("PaymentAccount", fields: [receivingAccountId], references: [id])
  verifier           User           @relation("FinanceVerifier", fields: [verifiedBy], references: [id])
  journalEntries     JournalEntry[] @relation("PaymentToJournal")

  @@index([invoiceId])
  @@map("payments")
}

model FundRequest {
  id             String            @id @default(uuid()) @db.Uuid
  requesterId    String            @db.Uuid
  departmentId   String
  amount         Decimal           @db.Decimal(15, 2)
  reason         String
  status         FundRequestStatus @default(PENDING_APPROVAL_MGR)
  attachmentUrls String[]
  approvedById   String?           @db.Uuid
  disbursedById  String?           @db.Uuid
  rejectReason   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  approver       User?             @relation("FundApprover", fields: [approvedById], references: [id])
  disburser      User?             @relation("FundDisburser", fields: [disbursedById], references: [id])
  requester      User              @relation("FundRequester", fields: [requesterId], references: [id])

  @@map("fund_requests")
}

model TaxRate {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique // e.g., "PPN 11%", "PPH 23"
  rate        Decimal @db.Decimal(5, 2)
  isActive    Boolean @default(true)
  description String?

  soEntries       SalesOrder[]
  soItemEntries   SalesOrderItem[]
  poItemEntries   PurchaseOrderItem[]
  taxTransactions TaxTransaction[]

  @@map("master_tax_rates")
}

model Currency {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique // e.g., "IDR", "USD"
  symbol       String?
  exchangeRate Decimal @default(1.0) @db.Decimal(15, 4)
  isMain       Boolean @default(false)

  pos PurchaseOrder[]
  sos SalesOrder[]

  @@map("master_currencies")
}

model AutoJournalConfig {
  transactionType String   @id
  coaDebetId      String   @db.Uuid
  coaCreditId     String   @db.Uuid
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("auto_journal_configs")
}

// ==========================================
// SPRINT 1 — Backend Schema Foundation
// 18 additional models appended per Foundation Phase Plan Task 5
// (Bill, DownPayment, APPayment, BankAccount, BankTransaction,
//  TaxTransaction already exist in finance-extension.prisma)
// ==========================================

/// Customer — AR-side customer (mirrors Supplier for AP side)
model Customer {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique // CUST-XXXX format
  name          String
  brand         String? // Brand name
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  npwp          String?
  creditLimit   Decimal        @default(0) @db.Decimal(15, 2)
  paymentTerms  Int            @default(30) // days
  isActive      Boolean        @default(true)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  invoices      SalesInvoice[]
  receipts      ARReceipt[]
  escrow        ClientEscrow[]

  @@map("customers")
}

/// SalesInvoice = AR-side customer invoice (mirrors unified Invoice for clean AR schema)
model SalesInvoice {
  id             String                 @id @default(uuid()) @db.Uuid
  invoiceNumber  String                 @unique
  customerId     String                 @db.Uuid
  invoiceDate    DateTime
  dueDate        DateTime
  subtotal       Decimal                @db.Decimal(15, 2)
  taxAmount      Decimal                @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal                @db.Decimal(15, 2)
  paidAmount     Decimal                @default(0) @db.Decimal(15, 2)
  paymentStatus  PaymentStatus          @default(PENDING)
  deliveryStatus String                 @default("PENDING") // PENDING | RELEASED | BLOCKED
  notes          String?
  attachmentUrls String[]               @default([])
  postedAt       DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  customer       Customer               @relation(fields: [customerId], references: [id])
  lineItems      SalesInvoiceLineItem[]
  receipts       ARReceipt[]
  journalEntries JournalEntry[]         @relation("SalesInvoiceJournalEntries")

  @@index([customerId, paymentStatus])
  @@index([dueDate, paymentStatus])
  @@map("sales_invoices")
}

/// SalesInvoiceLineItem = Line items of customer invoice
model SalesInvoiceLineItem {
  id        String       @id @default(uuid()) @db.Uuid
  invoiceId String       @db.Uuid
  itemCode  String
  itemName  String
  qty       Decimal      @db.Decimal(15, 2)
  unit      String
  price     Decimal      @db.Decimal(15, 2)
  discount  Decimal      @default(0) @db.Decimal(15, 2)
  total     Decimal      @db.Decimal(15, 2)
  invoice   SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("sales_invoice_line_items")
}

/// ARReceipt = Payment received from customer (Pelunasan/tagihan)
model ARReceipt {
  id             String        @id @default(uuid()) @db.Uuid
  receiptNumber  String        @unique
  customerId     String        @db.Uuid
  invoiceId      String?       @db.Uuid
  receiptDate    DateTime
  amount         Decimal       @db.Decimal(15, 2)
  pph23Amount    Decimal?      @db.Decimal(15, 2)
  bankAccountId  String?       @db.Uuid
  notes          String?
  attachmentUrls String[]      @default([])
  createdAt      DateTime      @default(now())
  customer       Customer      @relation(fields: [customerId], references: [id])
  invoice        SalesInvoice? @relation(fields: [invoiceId], references: [id])
  bankAccount    BankAccount?  @relation(fields: [bankAccountId], references: [id])

  @@index([customerId, receiptDate])
  @@map("ar_receipts")
}

/// SampleFee = Sample fee charged to customer (Biaya Sample)
model SampleFee {
  id           String   @id @default(uuid()) @db.Uuid
  feeNumber    String   @unique
  customerId   String   @db.Uuid
  amount       Decimal  @db.Decimal(15, 2)
  feeDate      DateTime
  notes        String?
  offsetToDPId String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sample_fees")
}

/// FixedAsset = Company owned fixed assets (Aset Tetap)
model FixedAsset {
  id                String                 @id @default(uuid()) @db.Uuid
  assetNumber       String                 @unique
  assetName         String
  assetCategory     String // e.g., "Kendaraan", "Peralatan", "Bangunan"
  acquisitionDate   DateTime
  acquisitionCost   Decimal                @db.Decimal(15, 2)
  usefulLife        Int // in months
  salvageValue      Decimal                @default(0) @db.Decimal(15, 2)
  status            String                 @default("ACTIVE") // ACTIVE | DISPOSED | TRANSFERRED
  location          String?
  responsiblePerson String?
  notes             String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  schedules         DepreciationSchedule[]
  transfers         AssetTransfer[]
  disposals         AssetDisposal[]

  @@map("fixed_assets")
}

/// DepreciationSchedule = Monthly depreciation entries per asset
model DepreciationSchedule {
  id          String     @id @default(uuid()) @db.Uuid
  assetId     String     @db.Uuid
  period      DateTime // Monthly period (first day of month)
  amount      Decimal    @db.Decimal(15, 2)
  accumulated Decimal    @default(0) @db.Decimal(15, 2)
  notes       String?
  asset       FixedAsset @relation(fields: [assetId], references: [id])

  @@unique([assetId, period])
  @@index([assetId])
  @@map("depreciation_schedules")
}

/// AssetTransfer = Asset location/responsibility transfer
model AssetTransfer {
  id           String     @id @default(uuid()) @db.Uuid
  assetId      String     @db.Uuid
  transferDate DateTime
  fromLocation String
  toLocation   String
  fromPerson   String?
  toPerson     String?
  notes        String?
  createdAt    DateTime   @default(now())
  asset        FixedAsset @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@map("asset_transfers")
}

/// AssetDisposal = Asset sale or write-off
model AssetDisposal {
  id           String     @id @default(uuid()) @db.Uuid
  assetId      String     @db.Uuid
  disposalDate DateTime
  disposalType String // SALE | WRITE_OFF | SCRAP
  proceeds     Decimal    @db.Decimal(15, 2)
  gainLoss     Decimal    @db.Decimal(15, 2)
  buyer        String?
  notes        String?
  createdAt    DateTime   @default(now())
  asset        FixedAsset @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@map("asset_disposals")
}

/// IntangibleAsset = Non-physical assets (software, licenses, patents)
model IntangibleAsset {
  id                 String   @id @default(uuid()) @db.Uuid
  assetNumber        String   @unique
  assetName          String
  acquisitionDate    DateTime
  acquisitionCost    Decimal  @db.Decimal(15, 2)
  amortizationPeriod Int // in months
  amortizationMethod String   @default("STRAIGHT_LINE")
  status             String   @default("ACTIVE")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("intangible_assets")
}

/// PeriodLock = Month/year period locking (penutupan periode)
model PeriodLock {
  id        String    @id @default(uuid()) @db.Uuid
  period    DateTime  @unique // First day of locked month
  isLocked  Boolean   @default(false)
  lockedBy  String?   @db.Uuid
  lockedAt  DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  @@map("period_locks")
}

/// ClosingChecklist = Period closing checklist items
model ClosingChecklist {
  id          String    @id @default(uuid()) @db.Uuid
  period      DateTime
  department  String
  item        String
  category    String? // e.g., "AR", "AP", "Inventory", "Finance"
  completed   Boolean   @default(false)
  completedBy String?   @db.Uuid
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([period, department])
  @@map("closing_checklists")
}

/// AdjustmentJournal = Manual adjusting entries (Jurnal Penyesuaian)
model AdjustmentJournal {
  id             String   @id @default(uuid()) @db.Uuid
  journalNumber  String   @unique
  period         DateTime
  description    String
  totalAmount    Decimal  @db.Decimal(15, 2)
  attachmentUrls String[] @default([])
  preparedBy     String?  @db.Uuid
  reviewedBy     String?  @db.Uuid
  approvedBy     String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("adjustment_journals")
}

/// JobOrderCosting = Job order cost tracking (Harga Poket Pesanan)
model JobOrderCosting {
  id             String    @id @default(uuid()) @db.Uuid
  jobOrderNumber String    @unique
  description    String?
  totalCost      Decimal   @db.Decimal(15, 2)
  totalRevenue   Decimal   @default(0) @db.Decimal(15, 2)
  recordedAt     DateTime  @default(now())
  closedAt       DateTime?

  @@map("job_order_costings")
}

/// CostVariance = Standard vs actual cost variance per job
model CostVariance {
  id           String   @id @default(uuid()) @db.Uuid
  jobOrderId   String   @db.Uuid
  varianceType String // MATERIAL | LABOR | OVERHEAD
  standardCost Decimal  @db.Decimal(15, 2)
  actualCost   Decimal  @db.Decimal(15, 2)
  variance     Decimal  @db.Decimal(15, 2)
  notes        String?
  createdAt    DateTime @default(now())

  @@index([jobOrderId])
  @@map("cost_variances")
}

/// ProductProfitability = Per-product profit analysis
model ProductProfitability {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  productName String
  period      DateTime
  revenue     Decimal  @db.Decimal(15, 2)
  cost        Decimal  @db.Decimal(15, 2)
  profit      Decimal  @db.Decimal(15, 2)
  margin      Decimal  @db.Decimal(5, 2) // percentage
  createdAt   DateTime @default(now())

  @@unique([productId, period])
  @@map("product_profitabilities")
}

/// CostAllocation = Overhead cost allocation to departments/products
model CostAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  allocationDate   DateTime
  amount           Decimal  @db.Decimal(15, 2)
  fromCostCenter   String
  toCostCenter     String
  allocationMethod String   @default("DIRECT") // DIRECT | STEP_DOWN | RECIPROCAL
  basis            String? // e.g., "square_feet", "headcount", "revenue"
  notes            String?
  createdAt        DateTime @default(now())

  @@map("cost_allocations")
}

/// ClientEscrow = Client trust fund / escrow account (Dana Titipan Klien)
model ClientEscrow {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @db.Uuid
  amount      Decimal   @db.Decimal(15, 2)
  depositDate DateTime
  releaseDate DateTime?
  status      String    @default("HELD") // HELD | RELEASED | RETURNED | FORFEITED
  purpose     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customer    Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId, status])
  @@map("client_escrows")
}

/// InventoryOwnership = Inventory owner tracking (ownership of stock)
model InventoryOwnership {
  id          String   @id @default(uuid()) @db.Uuid
  materialId  String   @db.Uuid
  warehouseId String   @db.Uuid
  ownerType   String // COMPANY | CONSIGNMENT | CUSTOMER_OWNED | SUPPLIER_OWNED
  ownerId     String?  @db.Uuid
  quantity    Decimal  @db.Decimal(15, 4)
  unitCost    Decimal  @default(0) @db.Decimal(15, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([materialId, warehouseId, ownerType, ownerId])
  @@index([ownerType])
  @@map("inventory_ownerships")
}

/// Specialized ledger for high-performance executive dashboards.
/// Stores aggregated figures to maintain confidentiality and query speed.
model FinancialSummaryLedger {
  id             String          @id @default(uuid()) @db.Uuid
  periodId       String          @db.Uuid
  category       String // e.g., "TOTAL_PAYROLL", "TOTAL_REVENUE", "COGS_TOTAL"
  nominalValue   Decimal         @db.Decimal(18, 2)
  currencyCode   String          @default("IDR")
  lastCalculated DateTime        @default(now())
  period         FinancialPeriod @relation(fields: [periodId], references: [id])

  @@unique([periodId, category, currencyCode])
  @@map("financial_summary_ledger")
}
