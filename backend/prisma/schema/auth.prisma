model User {
  id                              String                       @id @default(uuid()) @db.Uuid
  fullName                        String?
  email                           String                       @unique
  passwordHash                    String?
  roles                           UserRole[]
  status                          UserStatus                   @default(ACTIVE)
  managerPin                      String? // Phase 2: Escalation PIN
  approvalPin                     String? // Internal E-Signature PIN (APJ/Legal)
  createdAt                       DateTime                     @default(now())
  deletedAt                       DateTime?
  stateTransitionLogs             StateTransitionLog[]         @relation("StateChanger")
  bussdevProfile                  BussdevStaff?
  assignedLeads                   LeadCapture[]                @relation("LeadAssignee")
  verifiedAds                     DailyAdsMetric[]             @relation("AdsVerifier")
  marketingTaskPic                MarketingTask[]              @relation("MarketingTaskPic")
  marketingTaskReviewer           MarketingTask[]              @relation("MarketingTaskReviewer")
  marketingTaskAssignedBy         MarketingTask[]              @relation("MarketingTaskAssignedBy")
  marketingTaskHistory            MarketingTaskHistory[]       @relation("MarketingTaskHistoryActor")
  marketingTaskAttachment         MarketingTaskAttachment[]    @relation("MarketingTaskAttachmentUploader")
  marketingTaskComment            MarketingTaskComment[]       @relation("MarketingTaskCommentAuthor")
  marketingProjectOwner           MarketingProject[]           @relation("MarketingProjectOwner")
  marketingBrandOwner             MarketingBrand[]             @relation("MarketingBrandOwner")
  marketingTaskChecklistCompleted MarketingTaskChecklistItem[] @relation("MarketingTaskChecklistCompleter")
  marketingTeamMember             MarketingTeamMember?         @relation("MarketingTeamMemberUser")
  socialPostsAssigned             SocialPost[]                 @relation("SocialPostAssignee")
  socialPostsReviewed             SocialPost[]                 @relation("SocialPostReviewer")
  socialMediaUploaded             SocialPostMedia[]            @relation("SocialPostMediaUploader")
  lockedFormulas                  Formula[]                    @relation("FormulaLockedBy")
  approvedFunds                   FundRequest[]                @relation("FundApprover")
  disbursedFunds                  FundRequest[]                @relation("FundDisburser")
  fundRequests                    FundRequest[]                @relation("FundRequester")
  guestLogs                       GuestLog[]
  labTests                        LabTestResult[]
  lostDeals                       LostDeal[]
  verifiedPayments                Payment[]                    @relation("FinanceVerifier")
  verifiedAPPayments              APPayment[]                  @relation("APVerifier")
  reconciliations                 BankReconciliation[]         @relation("Reconciler")
  eprRequests                     EmergencyPurchaseRequest[]   @relation("EprRequester")
  warehouseAccess                 WarehouseAccess[]            @relation("WarehouseAccessUser")
  grantedAccess                   WarehouseAccess[]            @relation("WarehouseAccessGranter")
  prodPlans                       ProductionPlan[]             @relation("ProdAdmin")
  scmPO                           PurchaseOrder[]              @relation("SCMProcessor")
  registrations                   RegulatoryPipeline[]         @relation("LegalPIC")
  leadsManaged                    SalesLead[]                  @relation("BDLeads")
  salesTargets                    SalesTarget[]
  rndSamples                      SampleRequest[]              @relation("RNDFormulator")
  logistics                       Shipment[]                   @relation("LogisticsOfficer")
  laborGrade                      LaborGrade?
  escalationsApproved             AuditEscalation[]            @relation("EscalationApprover")
  employeeProfile                 Employee?
  approvedTickets                 Ticket[]                     @relation("TicketApprover")
  authorizedPayrolls              Payroll[]                    @relation("PayrollApprover")
  designFeedbacks                 DesignFeedback[]             @relation("DesignFeedbackAuthor")
  productionLogs                  ProductionLog[]              @relation("ProductionOperator")
  internalAudits                  InternalAudit[]              @relation("InternalAuditPic")
  qcAudits                        QCAudit[]                    @relation("QCOfficer")
  paymentApprovals                SampleRequest[]              @relation("PaymentApprovedBy")
  leadValidations                 LeadActivity[]               @relation("LeadActivityValidator")
  notifications                   Notification[]
  purchaseReturns                 PurchaseReturn[]             @relation("PurchaseReturnCreator")
  purchaseRequests                PurchaseRequest[]            @relation("PurchaseRequestCreator")
  requisitions                    MaterialRequisitionHeader[]  @relation("RequisitionRequester")
  qcChecklists                    QCChecklist[]                @relation("QCChecklistCreator")
  createdDrafts                   DocumentDraft[]              @relation("DraftCreator")
  approvedDrafts                  DocumentDraft[]              @relation("DocumentDraftApprover")
  rejectedDrafts                  DocumentDraft[]              @relation("DocumentDraftRejecter")

  // Communication Protocol (Wave 3/D1)
  communicationThreads     CommunicationThread[]      @relation("ThreadCreator")
  communicationReplies     CommunicationThreadReply[] @relation("ReplyAuthor")
  communicationMentions    CommunicationMention[]     @relation("MentionedUser")
  communicationAttachments CommunicationAttachment[]  @relation("AttachmentUploader")

  // Marketing prototype relations
  // NOTE: relations to MarketingProject, MarketingTaskAttachment,
  // MarketingTaskComment, MarketingTaskHistory, and MarketingTask sub-relations
  // commented out — local marketing.prisma does not define these models/
  // back-references (DB tables exist from production-light sync but model
  // definitions are tracked elsewhere). Uncomment once models + back-refs are
  // defined in marketing.prisma. Confirmed dead in src/ — no TS code references them.
  // marketingProjects MarketingProject[]
  // tasksAssignedBy  MarketingTask[]              @relation("TaskAssignedBy")
  // tasksPic        MarketingTask[]              @relation("TaskPic")
  // tasksReviewer   MarketingTask[]              @relation("TaskReviewer")
  // taskAttachments MarketingTaskAttachment[]
  // taskComments    MarketingTaskComment[]
  // taskHistories   MarketingTaskHistory[]

  @@map("users")
}
