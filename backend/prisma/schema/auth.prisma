// ⚠️ PRODUCTION-LIGHT: Semua relasi ke module lain dihapus
// karena module tersebut tidak aktif. Lihat PRODUCTION_LIGHT.md
// untuk cara mengembalikan.

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String?
  email        String     @unique
  passwordHash String?
  roles        UserRole[]
  status       UserStatus @default(ACTIVE)
  managerPin   String?
  approvalPin  String?
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?

  // HR relations
  employee     Employee?
  approvedTickets Ticket[]     @relation("TicketApprover")
  approvedPayrolls Payroll[]  @relation("PayrollApprover")

  // Lead Capture
  leadAssignedLeads         LeadCapture[]      @relation("LeadAssignee")
  marketingTasksAsPic       MarketingTask[]     @relation("MarketingTaskPic")
  marketingTasksAsReviewer  MarketingTask[]     @relation("MarketingTaskReviewer")
  marketingTasksAssignedBy  MarketingTask[]     @relation("MarketingTaskAssignedBy")
  adsVerified               DailyAdsMetric[]    @relation("AdsVerifier")
  marketingTaskHistory      MarketingTaskHistory[] @relation("MarketingTaskHistoryActor")
  marketingTaskAttachments  MarketingTaskAttachment[] @relation("MarketingTaskAttachmentUploader")
  marketingTaskComments     MarketingTaskComment[] @relation("MarketingTaskCommentAuthor")
  marketingProjectsOwned    MarketingProject[]  @relation("MarketingProjectOwner")
  marketingBrandsOwned      MarketingBrand[]    @relation("MarketingBrandOwner")
  marketingChecklistCompleted MarketingTaskChecklistItem[] @relation("MarketingTaskChecklistCompleter")
  socialPostsAssigned       SocialPost[]        @relation("SocialPostAssignee")
  socialPostsReviewed       SocialPost[]        @relation("SocialPostReviewer")
  socialPostMediaUploaded   SocialPostMedia[]   @relation("SocialPostMediaUploader")
  marketingTeamMembers      MarketingTeamMember[] @relation("MarketingTeamMemberUser")

  @@map("users")
}
