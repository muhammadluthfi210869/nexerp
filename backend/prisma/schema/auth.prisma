model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String?
  email        String     @unique
  passwordHash String?
  roles        UserRole[]
  status       UserStatus @default(ACTIVE)
  managerPin   String?
  approvalPin  String?
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?

  @@map("users")
}
