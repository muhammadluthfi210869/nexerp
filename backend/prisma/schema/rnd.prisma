// ═══════════════════════════════════════════════════════════════
// 🟢 PRODUCTION-LIGHT: Hanya model yang dipakai oleh 3 halaman:
//    Analytics Trend, Daily Tracking, Project Monitoring
//    Lihat PRODUCTION_LIGHT.md untuk cara mengembalikan.
// ═══════════════════════════════════════════════════════════════

model RndDailyTask {
  id                String    @id @default(uuid()) @db.Uuid
  date              DateTime  @db.Date
  pic               String
  noNpf             String?
  projectName       String
  category          String    @default("New Sample")
  busdev            String?
  task              String?
  targetSampleCount Int       @default(1)
  status            String    @default("On Progress")
  progress          Int       @default(0)
  kendala           String?
  nextAction        String?
  deadline          DateTime? @db.Date
  tanggalMasuk      DateTime  @db.Date
  tanggalDone       DateTime? @db.Date
  createdById       String?   @db.Uuid
  createdAt         DateTime  @default(now())

  @@map("rnd_daily_tasks")
}

model RndProject {
  id             String    @id @default(uuid()) @db.Uuid
  projectName    String
  pic            String
  client         String?
  category       String?
  noNpf          String?
  busdev         String?
  status         String    @default("In progress")
  startDate      DateTime  @db.Date
  deadline       DateTime? @db.Date
  totalDays      Int?
  revisionCount  Int       @default(0)
  trialCount     Int       @default(0)
  notes          String?
  createdById    String?   @db.Uuid
  createdAt      DateTime  @default(now())

  @@map("rnd_projects")
}

model RndWeeklyPerformance {
  id               String   @id @default(uuid()) @db.Uuid
  pic              String
  weekLabel        String
  weekStart        DateTime @db.Date
  weekEnd          DateTime @db.Date
  totalTask        Int      @default(0)
  doneCount        Int      @default(0)
  delayedCount     Int      @default(0)
  failedTrial      Int      @default(0)
  revisionCount    Int      @default(0)
  ontimePct        Float    @default(0)
  trialSuccessRate Float    @default(0)
  initiativeScore  Float    @default(0)
  weeklyScore      Float    @default(0)
  notes            String?
  createdAt        DateTime @default(now())

  @@map("rnd_weekly_performances")
}

model RndFailedTrial {
  id                  String   @id @default(uuid()) @db.Uuid
  date                DateTime @db.Date
  projectFormula      String
  pic                 String
  problemSymptom      String
  rootCause           String?
  correctionAttempted String?
  solution            String?
  finalLearning       String?
  applicableTo        String?
  createdAt           DateTime @default(now())

  @@map("rnd_failed_trials")
}

model RndHeadTracker {
  id                String   @id @default(uuid()) @db.Uuid
  date              DateTime @db.Date
  strategicTask     String?
  teamSupport       String?
  approvalGiven     String?
  innovationConcept String?
  escalationHandled String?
  notes             String?
  createdById       String?  @db.Uuid
  createdAt         DateTime @default(now())

  @@map("rnd_head_trackers")
}

model RndMonthlyKpi {
  id                   String @id @default(uuid()) @db.Uuid
  month                String
  pic                  String
  ontimePct            Float   @default(0)
  trialSuccessRate     Float   @default(0)
  revisionRate         Float   @default(0)
  initiativeScore      Float   @default(0)
  knowledgeContribution Float  @default(0)
  compositeScore       Float?
  grade                String?
  createdAt            DateTime @default(now())

  @@map("rnd_monthly_kpis")
}
