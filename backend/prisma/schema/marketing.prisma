model MarketingReportingPeriod {
  id           String   @id @default(uuid()) @db.Uuid
  brandId      String   @db.Uuid
  brand        MarketingBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  periodStart  DateTime @db.Date
  periodEnd    DateTime @db.Date
  timezone     String   @default("Asia/Jakarta") @db.VarChar(80)
  status       String   @default("DRAFT") @db.VarChar(30)
  createdById  String?  @db.Uuid
  verifiedById String?  @db.Uuid
  verifiedAt   DateTime?
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  channelMetrics BrandChannelMetric[]
  weeklyReports  WeeklySocialReport[]
  storyMetrics   StoryDailyMetric[]
  funnels        MarketingChannelFunnel[]

  @@unique([brandId, periodStart, periodEnd])
  @@index([status, periodEnd])
  @@map("marketing_reporting_periods")
}

model BrandChannelMetric {
  id             String   @id @default(uuid()) @db.Uuid
  periodId       String   @db.Uuid
  period         MarketingReportingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  channel        String   @db.VarChar(50)
  source         String   @default("MANUAL") @db.VarChar(30)
  followersStart Int      @default(0)
  followersEnd   Int      @default(0)
  followersGained Int     @default(0)
  followersLost  Int      @default(0)
  reach          BigInt   @default(0)
  views          BigInt   @default(0)
  impressions    BigInt   @default(0)
  likes          BigInt   @default(0)
  comments       BigInt   @default(0)
  shares         BigInt   @default(0)
  saves          BigInt   @default(0)
  clicks         BigInt   @default(0)
  spend          Decimal  @default(0) @db.Decimal(18, 2)
  revenue        Decimal  @default(0) @db.Decimal(18, 2)
  leads          Int      @default(0)
  sampleRequests Int      @default(0)
  deals          Int      @default(0)
  externalId     String?  @db.VarChar(160)
  enteredById    String?  @db.Uuid
  verifiedById   String?  @db.Uuid
  verifiedAt     DateTime?
  syncedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([periodId, channel, source])
  @@index([channel, syncedAt])
  @@map("brand_channel_metrics")
}

model WeeklySocialReport {
