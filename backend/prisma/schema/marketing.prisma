model StoryDailyMetric {
  id             String   @id @default(uuid()) @db.Uuid
  periodId       String   @db.Uuid
  period         MarketingReportingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  brandId        String   @db.Uuid
