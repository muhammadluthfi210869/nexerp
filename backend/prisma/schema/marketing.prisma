// ── Notion Social Media Planner & Meta Hub ───────────────────────────────

model SocialPost {
  id             String                @id @default(uuid()) @db.Uuid
  title          String                @db.VarChar(255)
  platform       String                @default("instagram") @db.VarChar(50) // instagram, facebook, tiktok, threads, youtube, linkedin
  contentType    String                @default("single_post") @db.VarChar(50) // reel, carousel, single_post, story, video, live
  status         String                @default("idea") @db.VarChar(50) // idea, scripting, review, scheduled, published, archived
  scheduledDate  DateTime?
  publishedDate  DateTime?
  pillar         String                @default("Educational") @db.VarChar(100)
  caption        String                @default("") @db.Text
  hooks          String[]              @default([])
  cta            String                @default("") @db.VarChar(255)
  hashtags       String[]              @default([])
  coverImage     String?               @db.Text
  mediaUrls      String[]              @default([])
  authorName     String                @default("Marketing Team") @db.VarChar(100)
  authorAvatar   String?               @db.Text
  authorRole     String                @default("Content Creator") @db.VarChar(100)
  metaPostId     String?               @db.VarChar(100)
  metaPermalink  String?               @db.Text
  notes          String?               @db.Text
  targetAudience String?               @db.VarChar(255)
  campaign       String?               @db.VarChar(255)
  calloutText    String?               @db.Text
  calloutEmoji   String?               @db.VarChar(20)
  
  // Performance metrics cache
  reach          Int                   @default(0)
  impressions    Int                   @default(0)
  likes          Int                   @default(0)
  comments       Int                   @default(0)
  shares         Int                   @default(0)
  saves          Int                   @default(0)
  videoViews     Int                   @default(0)
  clicks         Int                   @default(0)
  engagementRate Decimal               @default(0) @db.Decimal(5, 2)
  viralityScore  Int                   @default(0)
  costPerResult  Decimal               @default(0) @db.Decimal(12, 2)

  // Phase 2 relational identity and concurrency fields.
  brandId        String?               @db.Uuid
  brand          MarketingBrand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  assigneeId     String?               @db.Uuid
  assignee       User?                 @relation("SocialPostAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewerId     String?               @db.Uuid
  reviewer       User?                 @relation("SocialPostReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  brief          String?               @db.Text
  referenceUrl   String?               @db.Text
  canonicalStatus String               @default("IDEA") @db.VarChar(30)
  version        Int                   @default(1)
  metricsSyncedAt DateTime?

  checklist      SocialChecklistItem[]
  media           SocialPostMedia[]
  metricSnapshots SocialPostMetricSnapshot[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([platform])
  @@index([status])
  @@index([scheduledDate])
  @@index([brandId, scheduledDate])
  @@index([assigneeId, status])
  @@index([canonicalStatus, scheduledDate])
  @@index([metricsSyncedAt])
  @@map("social_posts")
}

model SocialChecklistItem {
  id        String     @id @default(uuid()) @db.Uuid
  postId    String     @db.Uuid
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
