  deals          Int      @default(0)
  spend          Decimal  @default(0) @db.Decimal(18, 2)
  dealValue      Decimal  @default(0) @db.Decimal(18, 2)
  notes          String?  @db.Text
  enteredById    String?  @db.Uuid
  verifiedById   String?  @db.Uuid
  verifiedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([periodId, channel])
  @@map("marketing_channel_funnels")
}

model MarketingIntegrationConnection {
  id               String   @id @default(uuid()) @db.Uuid
  brandId          String   @db.Uuid
  brand             MarketingBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  provider         String   @db.VarChar(50)
  status           String   @default("DISCONNECTED") @db.VarChar(30)
  secretCiphertext String?  @db.Text
  secretIv         String?  @db.VarChar(255)
  secretTag        String?  @db.VarChar(255)
  keyVersion       Int      @default(1)
  config           Json     @default("{}")
  scopes           String[] @default([])
  tokenExpiresAt   DateTime?
  lastSyncAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  syncJobs MarketingIntegrationSyncJob[]

  @@unique([brandId, provider])
  @@index([provider, status])
  @@map("marketing_integration_connections")
}

model MarketingIntegrationSyncJob {
  id             String   @id @default(uuid()) @db.Uuid
  connectionId   String   @db.Uuid
  connection     MarketingIntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  brandId        String   @db.Uuid
  brand          MarketingBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  provider       String   @db.VarChar(50)
  status         String   @default("QUEUED") @db.VarChar(30)
  startedAt      DateTime?
  finishedAt     DateTime?
  importedCount  Int      @default(0)
  skippedCount   Int      @default(0)
  errorCode      String?  @db.VarChar(100)
  errorMessage   String?  @db.Text
  triggeredById  String?  @db.Uuid
  createdAt      DateTime @default(now())

  @@index([connectionId, createdAt])
  @@index([status, createdAt])
  @@map("marketing_integration_sync_jobs")
}

model MarketingIdempotencyKey {
  id           String   @id @default(uuid()) @db.Uuid
  scope        String   @db.VarChar(160)
