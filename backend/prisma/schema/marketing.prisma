model MarketingTask {
  id          String    @id @default(uuid()) @db.Uuid
  taskCode    String    @unique @db.VarChar(100)
  ownerId     String    @db.Uuid
  assigneeId  String?   @db.Uuid
  title       String
  description String?
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  channel     String    @default("General") @db.VarChar(100)
  category    String    @default("general_operations") @db.VarChar(100)
  brand       String    @default("Dreamlab") @db.VarChar(50)
  estimatedHours Int    @default(0)
  actualHours    Int    @default(0)
  revisionCount  Int    @default(0)
  checklistDone  Int    @default(0)
  checklistTotal Int    @default(0)
  brief       String?   @db.Text
  link        String?   @db.Text
  tags        String?   @db.Text
  sla         String?   @db.VarChar(50)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Phase 2 canonical fields. Legacy fields above stay readable during the
  // expand/backfill/contract rollout.
  taskType         String @default("DAILY") @db.VarChar(30)
  canonicalStatus  String @default("NOT_STARTED") @db.VarChar(30)
  outputUrl        String? @db.Text
  referenceUrl     String? @db.Text
  estimatedMinutes Int     @default(0)
  actualMinutes    Int     @default(0)
  version          Int     @default(1)

  // Relations restored for the marketing task subsystem
  projectId    String?                   @db.Uuid
  project      MarketingProject?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  picId        String?                   @db.Uuid
  pic          User?                     @relation("MarketingTaskPic", fields: [picId], references: [id], onDelete: SetNull)
  reviewerId   String?                   @db.Uuid
  reviewer     User?                     @relation("MarketingTaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  assignedById String?                   @db.Uuid
  assignedBy   User?                     @relation("MarketingTaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  history      MarketingTaskHistory[]
  attachments  MarketingTaskAttachment[]
  comments     MarketingTaskComment[]
  checklist    MarketingTaskChecklistItem[]
  brandId      String?                   @db.Uuid
  brandRef     MarketingBrand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([assigneeId])
  @@index([status])
  @@index([canonicalStatus, dueDate])
  @@index([brandId])
  @@index([projectId])
  @@map("marketing_tasks")
}

