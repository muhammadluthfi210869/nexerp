model DailyAdsMetric {
  id             String        @id @default(uuid()) @db.Uuid
  date           DateTime      @db.Date
  platform       TrafficSource
  spend          Decimal       @db.Decimal(15, 2)
  impressions    Int           @default(0)
  reach          Int           @default(0)
  clicks         Int           @default(0)
  leadsGenerated Int           @default(0)
  campaignName   String?
  isAudited      Boolean       @default(false)
  auditedById    String?       @db.Uuid
  auditedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  verifier       User?         @relation("AdsVerifier", fields: [auditedById], references: [id])

  @@unique([date, platform, campaignName])
  @@map("daily_ads_metrics")
}

model MarketingTarget {
  id              String   @id @default(uuid()) @db.Uuid
  month           Int
  year            Int
  leadTarget      Int      @default(0)
  postTarget      Int      @default(0)
  revenueTarget   Decimal  @default(0) @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  clientAcqTarget Int      @default(0)
  sampleTarget    Int      @default(0)
  spendTarget     Decimal  @default(0) @db.Decimal(15, 2)

  @@unique([month, year])
  @@map("marketing_targets")
}

model ContentAsset {
  id             String          @id @default(uuid()) @db.Uuid
  publishDate    DateTime        @db.Date
  platform       TrafficSource
  contentPillar  ContentCategory
  title          String
  url            String?
  views          Int             @default(0)
  likes          Int             @default(0)
  comments       Int             @default(0)
  shares         Int             @default(0)
  saves          Int             @default(0)
  engagementRate Decimal         @default(0) @db.Decimal(5, 2)
  auditStatus    String          @default("PENDING")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("content_assets")
}

model SearchVisibilityMetric {
  id          String   @id @default(uuid()) @db.Uuid
  month       Int
  year        Int
  impressions BigInt   @default(0)
  clicks      BigInt   @default(0)
  avgCtr      Decimal  @default(0) @db.Decimal(5, 2)
  avgPosition Decimal  @default(0) @db.Decimal(3, 1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([month, year])
  @@map("search_visibility_metrics")
}

model AccountHealthLog {
  id             String        @id @default(uuid()) @db.Uuid
  platform       TrafficSource
  totalFollowers Int           @default(0)
  followerGrowth Int           @default(0)
  unfollows      Int           @default(0)
  totalReach     Int           @default(0)
  profileVisits  Int           @default(0)
  postsCount     Int           @default(0)
  storiesCount   Int           @default(0)
  avgStoryViews  Int           @default(0)
  likesCount     Int           @default(0)
  commentsCount  Int           @default(0)
  savesCount     Int           @default(0)
  sharesCount    Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  weekNumber     Int
  year           Int

  @@unique([year, weekNumber, platform])
  @@map("account_health_logs")
}

// ─────────────────────────────────────────────────────────────
//  LEAD CAPTURE — DreamLab.id WA lead tracking (Fase 1)
// ─────────────────────────────────────────────────────────────

model LeadCapture {
  id           String @id @default(uuid()) @db.Uuid
  trackingCode String @unique @db.VarChar(20)

  // ── Website Tracking (invisible, captured before WA redirect) ──
  sessionId   String? @db.VarChar(100)
  intent      String? @db.Text
  pageUrl     String? @db.Text
  pageTitle   String? @db.VarChar(255)
  referrer    String? @db.Text
  utmSource   String? @db.VarChar(100)
  utmMedium   String? @db.VarChar(100)
  utmCampaign String? @db.VarChar(100)
  utmContent  String? @db.VarChar(100)
  utmTerm     String? @db.VarChar(100)
  deviceType  String? @db.VarChar(50)
  browser     String? @db.VarChar(100)
  ipAddress   String? @db.VarChar(45)
  city        String? @db.VarChar(100)
  country     String? @db.VarChar(100)

  // ── WhatsApp Data (captured when user messages) ──
  phone       String?   @db.VarChar(20)
  waName      String?   @db.VarChar(255)
  waMessage   String?   @db.Text
  contactedAt DateTime?

  // ── CRM Fields ──
  fullName String? @db.VarChar(255)
  company  String? @db.VarChar(255)
  email    String? @db.VarChar(255)
  notes    String? @db.Text

  // ── AI Extraction metadata (Fase 3.1) ──
  aiExtractedAt DateTime?
  aiStatus      String?   @db.VarChar(20)
  aiStage       Json?

  // ── Relations ──
  attributes LeadAttribute[]
  messages   LeadMessage[]

  status LeadStatus  @default(PENDING)
  source LeadSource?

  assignedTo   String? @db.Uuid
  assignedUser User?   @relation(fields: [assignedTo], references: [id])

  // ── Round Robin Tracking ──
  assignedName    String?   @db.VarChar(100)
  assignedPhone   String?   @db.VarChar(20)
  // Stable Sales identity from the VPS / ERP round-robin (e.g. cs1, cs2,
  // cs3, irma). Persisted against the tracking code so reloading the
  // thank-you page does NOT silently reassign the same lead to a
  // different Sales.
  assignedSalesId String?   @db.VarChar(50)
  assignedAt      DateTime?

  // ── Lead Attribution Journey (Website → ERP bridge) ──
  // The source page URL where the CTA was originally clicked (e.g.
  // /jasa-maklon-kosmetik/). Passed through thank-you → bridge as `from`.
  sourcePage         String?   @db.VarChar(500)
  // Type of CTA that triggered the journey (smart-wa-button, floating-wa,
  // hero-cta, etc.). Set at CTA click; carries forward to thank-you → bridge.
  ctaType            String?   @db.VarChar(50)
  ctaClickedAt       DateTime?
  // The thank-you page URL where round-robin assignment + bridge call ran.
  thankYouPage       String?   @db.VarChar(500)
  thankYouViewedAt   DateTime?
  // The moment the user clicked the WhatsApp button (thank-you CTA).
  // Recorded by the website via fire-and-forget PUT to
  // /lead-capture/whatsapp-click/:trackingCode.
  whatsappClickedAt  DateTime?
  // ── Self QR verification placeholders (Batch 4). Never inferred from
  // browser/IP/device. NULL until an actual inbound WhatsApp conversation
  // is matched against [Kode: <trackingCode>] by the Self QR pipeline.
  whatsappVerifiedAt DateTime?
  // ── Verification status. UNVERIFIED at create time. Becomes VERIFIED only
  // after Self QR matches an inbound chat to this tracking code.
  verificationStatus String    @default("UNVERIFIED") @db.VarChar(20)

  // ── Sales Pipeline ──
  workflowStatus WorkflowStatus @default(NEW_LEAD)
  lostReason     LostReason?
  lostAt         DateTime?
  wonAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
  @@index([assignedSalesId])
  @@index([sourcePage])
  @@map("lead_captures")
}

// Log percakapan WhatsApp — setiap pesan = 1 baris (Fase 2.2)
model LeadMessage {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  direction String   @default("INBOUND") @db.VarChar(10)
  phone     String?  @db.VarChar(20)
  waName    String?  @db.VarChar(255)
  body      String   @db.Text
  msgId     String?  @unique @db.VarChar(100)
  createdAt DateTime @default(now())

  lead LeadCapture @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_messages")
}

// Atribut lead extensible (Option B) — key-value, scalable
model LeadAttribute {
  id         String   @id @default(uuid()) @db.Uuid
  leadId     String   @db.Uuid
  key        String   @db.VarChar(50)
  value      String?  @db.VarChar(255)
  confidence Float    @default(0)
  source     String?  @db.Text
  confirmed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lead LeadCapture @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, key])
  @@index([leadId])
  @@map("lead_attributes")
}

// Round Robin untuk distribusi lead ke nomor WA sales
model RoundRobinAgent {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  phoneNumber String   @db.VarChar(20)
  orderIndex  Int
  isActive    Boolean  @default(true)
  totalLeads  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("round_robin_agents")
}

model RoundRobinState {
  id           String   @id @default("singleton")
  currentIndex Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("round_robin_state")
}

// ─────────────────────────────────────────────────────────────
//  QR CODES — Sales attribution via physical/digital QR scan
// ─────────────────────────────────────────────────────────────
// Each QR has a unique public `token` (URL-safe) and an internal
// `trackingCode` (matches LeadCapture.trackingCode shape). When a
// customer scans the QR, the public /q/:token route resolves to a
// thank-you page that fires the existing LeadCapture /track pipeline
// with via=qr. LeadCapture then notifies QR via /attributed/:code to
// increment leadCount.
model QrCode {
  id              String        @id @default(uuid()) @db.Uuid
  token           String        @unique @db.VarChar(16)
  trackingCode    String        @unique @db.VarChar(20)
  channel         String        @db.VarChar(20) // WHATSAPP|INSTAGRAM|TIKTOK|OFFLINE|EMAIL|OTHER
  campaign        String?       @db.VarChar(100)
  assignedSalesId String?       @db.Uuid
  assignedSales   User?         @relation("QrCodeSales", fields: [assignedSalesId], references: [id], onDelete: SetNull)
  metadata        Json?
  isActive        Boolean       @default(true)
  expiresAt       DateTime?
  scanCount       Int           @default(0)
  leadCount       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([assignedSalesId])
  @@index([channel])
  @@index([createdAt])
  @@map("qr_codes")
}
