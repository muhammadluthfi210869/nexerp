{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-fast-pdf.cjs"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "diagnostics": false }]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@nestjs/config)/)"
  ]
}
