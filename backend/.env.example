# Server
PORT=3002
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/erp_db?schema=public"

# Auth
JWT_SECRET="change-this-to-a-random-secret"

# Encryption
AES_SECRET_KEY="change-this-to-a-32-char-secret"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Logging
LOG_LEVEL=info

# P07 — server-owned organization for the PUBLIC lead-capture intake
# (track + WhatsApp webhook). Public requests can never override it.
P07_PUBLIC_LEAD_ORGANIZATION_ID="00000000-0000-4000-8000-000000000000"
