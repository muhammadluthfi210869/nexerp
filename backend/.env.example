# Server
PORT=3002
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/erp_db?schema=public"

# Auth
JWT_SECRET="change-this-to-a-random-secret"

# Encryption
AES_SECRET_KEY="change-this-to-a-32-char-secret"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Logging
LOG_LEVEL=info

# Kommo CRM
# Accepts either "dreamlabofficial" or "https://dreamlabofficial.kommo.com/"
KOMMO_SUBDOMAIN=dreamlabofficial
KOMMO_API_TOKEN="your-kommo-access-token"
KOMMO_AUTO_PULL_ENABLED=true
KOMMO_AUTO_PULL_INTERVAL_MS=300000
