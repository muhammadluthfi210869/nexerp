# Server
PORT=3002
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/erp_db?schema=public"

# Auth
JWT_SECRET="change-this-to-a-random-secret"

# Local-only escape hatch for manually testing canonical marketing endpoints.
# Keep false in shared, staging, and production environments.
MARKETING_DEV_AUTH_BYPASS=false

# Encryption
AES_SECRET_KEY="change-this-to-a-32-char-secret"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Logging
LOG_LEVEL=info
