# Server
PORT=3002
NODE_ENV=development

# Database — required, non-empty, must look like a real connection URL.
# SQLite (file:) is allowed only for tests.
DATABASE_URL="postgresql://postgres:password@localhost:5432/erp_db?schema=public"

# Auth — required, >= 32 chars. Backend aborts boot if missing/short.
# Generate:  openssl rand -hex 32
# Replace per-environment. Do NOT commit a real production value.
JWT_SECRET="REPLACE_WITH_OPENSSL_RAND_HEX_32_OR_LONGER"

# Encryption — required, >= 32 chars (256-bit symmetric key).
# Generate:  openssl rand -hex 32
# Rotating this requires a re-encryption migration over all encrypted columns.
AES_SECRET_KEY="REPLACE_WITH_OPENSSL_RAND_HEX_32_OR_LONGER"

# CORS — required in production. Comma-separated whitelist of allowed origins.
# In dev any origin is accepted; in prod this value is enforced verbatim.
CORS_ORIGIN="http://localhost:3000"

# Logging
LOG_LEVEL=info

# ── NEX ERP Batch 1: Self-Hosted WhatsApp QR Collector ──
# Comma-separated PN-canonical (or +62 / 0-prefixed) phones for known
# internal Sales devices. Protects against device-as-customer misclass.
# Authoritative Marketing Sales roster: Nisa / Jessica / Diaz / Irma.
SELF_QR_INTERNAL_DEVICE_PHONES=6281952417051,6287712232389,6287776550657,6285133188827

# Baileys library log level: silent | fatal | error | warn (default silent).
SELF_QR_BAILEYS_LOG_LEVEL=silent

# Storage root for per-device Baileys auth state (NEVER commit).
SELF_QR_AUTH_ROOT=storage/self-qr-auth

# ── Website → ERP bridge (Dreamlab.id lead attribution) ──
# Shared secret presented by the website's /api/lead-capture/erp-track
# in `x-dreamlab-bridge-secret`. MUST match ERP_BRIDGE_SECRET on the
# website side. Generate with `openssl rand -hex 32`.
ERP_BRIDGE_SECRET=""
