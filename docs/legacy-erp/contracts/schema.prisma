  updatedAt      DateTime  @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  coa1Debit    Coa? @relation("CoaAutoDebit1", fields: [coa1DebitId], references: [id], onDelete: SetNull)
  coa1Credit   Coa? @relation("CoaAutoCredit1", fields: [coa1CreditId], references: [id], onDelete: SetNull)
  coa2Debit    Coa? @relation("CoaAutoDebit2", fields: [coa2DebitId], references: [id], onDelete: SetNull)
  coa2Credit   Coa? @relation("CoaAutoCredit2", fields: [coa2CreditId], references: [id], onDelete: SetNull)
  coa3Debit    Coa? @relation("CoaAutoDebit3", fields: [coa3DebitId], references: [id], onDelete: SetNull)
  coa3Credit   Coa? @relation("CoaAutoCredit3", fields: [coa3CreditId], references: [id], onDelete: SetNull)
  coa4Debit    Coa? @relation("CoaAutoDebit4", fields: [coa4DebitId], references: [id], onDelete: SetNull)
  coa4Credit   Coa? @relation("CoaAutoCredit4", fields: [coa4CreditId], references: [id], onDelete: SetNull)
  coa5Debit    Coa? @relation("CoaAutoDebit5", fields: [coa5DebitId], references: [id], onDelete: SetNull)
  coa5Credit   Coa? @relation("CoaAutoCredit5", fields: [coa5CreditId], references: [id], onDelete: SetNull)
  coa6Debit    Coa? @relation("CoaAutoDebit6", fields: [coa6DebitId], references: [id], onDelete: SetNull)
  coa6Credit   Coa? @relation("CoaAutoCredit6", fields: [coa6CreditId], references: [id], onDelete: SetNull)

  @@unique([organizationId, transactionEvent])
  @@index([transactionEvent])
  @@map("coa_auto")
}

model Formulation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique // 'SS-YYYYMM-NNNNNN'
  date           DateTime @db.Date
  name           String
  note           String?
  goodsId        String?  @db.Uuid // final product reference
  status         String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | LOCKED
  currentRev     Int      @default(0)
  lockedAt       DateTime? @db.Timestamptz
  lockedByUserId String?   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goods         Goods?       @relation(fields: [goodsId], references: [id], onDelete: SetNull)
  adjustments   FormulationAdjustment[]

  @@index([organizationId, status])
  @@index([goodsId])
  @@map("formulations")
}

model FormulationAdjustment {
  id             String   @id @default(uuid()) @db.Uuid
  formulationId  String   @db.Uuid
  organizationId String   @db.Uuid
  date           DateTime @db.Date
  rev            Int
  netto          Decimal? @db.Decimal(18, 4)
  note           String?
  status         String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  adjustedById   String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz

