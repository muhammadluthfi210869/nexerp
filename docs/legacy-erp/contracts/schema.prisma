// =============================================================================
// SECTION 5 — PRODUCTION & R&D
// =============================================================================
// BatchRecord → ScheduleMixing → ProductionMixing → ScheduleFilling → ...
// =============================================================================

model BatchRecord {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @db.Uuid
  code                String   @unique
  date                DateTime @db.Date
  salesOrderId        String   @db.Uuid // bridge (DEC-017)
  salesOrderDetailId  String?  @db.Uuid
  attachment          String?  // PDF/photo URL (CPKB evidence)
  note                String?
  status              String   @default("DRAFT") // DRAFT | APPROVED | LOCKED | IN_PROGRESS | COMPLETED
  formulaLocked       Boolean  @default(false)
  formulationId       String?  @db.Uuid
  makerUserId         String?  @db.Uuid
  legacyId            Int?     @unique
  createdAt           DateTime @default(now()) @db.Timestamptz
  updatedAt           DateTime @updatedAt @db.Timestamptz
  deletedAt           DateTime? @db.Timestamptz

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder        SalesOrder           @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  maker             User?                @relation("BatchRecordMaker", fields: [makerUserId], references: [id], onDelete: SetNull)
  scheduleMixings   ScheduleMixing[]
  scheduleFillings  ScheduleFilling[]
  schedulePackagings SchedulePackaging[]
  productionMixings ProductionMixing[]
  productionFillings ProductionFilling[]
  productionPackagings ProductionPackaging[]
  deliveryOuts      DeliveryOut[]

  @@index([organizationId, status])
  @@index([salesOrderId])
  @@map("batch_records")
}

model ScheduleMixing {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  batchRecordId  String   @db.Uuid
  scheduleDate   DateTime @db.Date
  targetPcs      Decimal  @db.Decimal(18, 2)
  hasilUpscale   Decimal? @db.Decimal(18, 2)
  status         String   @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  makerUserId    String?  @db.Uuid
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchRecord     BatchRecord     @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  maker           User?           @relation("ScheduleMixingMaker", fields: [makerUserId], references: [id], onDelete: SetNull)
  productionMixings ProductionMixing[]

  @@index([organizationId, status])
  @@index([batchRecordId])
  @@map("schedule_mixings")
}

model ScheduleFilling {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  batchRecordId  String   @db.Uuid
  scheduleDate   DateTime @db.Date
  targetPcs      Decimal  @db.Decimal(18, 2)
  packagingId    String?  @db.Uuid // Goods id of primary packaging
  hasil          Decimal? @db.Decimal(18, 2)
  status         String   @default("PLANNED")
  makerUserId    String?  @db.Uuid
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchRecord     BatchRecord     @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  maker           User?           @relation("ScheduleFillingMaker", fields: [makerUserId], references: [id], onDelete: SetNull)
  productionFillings ProductionFilling[]

  @@index([organizationId, status])
  @@map("schedule_fillings")
}

model SchedulePackaging {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  batchRecordId  String   @db.Uuid
  scheduleDate   DateTime @db.Date
  targetPcs      Decimal  @db.Decimal(18, 2)
  secondaryPackagingId String? @db.Uuid
  hasil          Decimal? @db.Decimal(18, 2)
  status         String   @default("PLANNED")
  makerUserId    String?  @db.Uuid
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchRecord     BatchRecord     @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  maker           User?           @relation("SchedulePackagingMaker", fields: [makerUserId], references: [id], onDelete: SetNull)
  productionPackagings ProductionPackaging[]

  @@index([organizationId, status])
  @@map("schedule_packagings")
}

model ProductionMixing {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  scheduleMixingId String  @db.Uuid
  batchRecordId  String   @db.Uuid
  date           DateTime @db.Date
  resultBulk     Decimal? @db.Decimal(18, 4) // kg
  temperature    Decimal? @db.Decimal(8, 2)
  rpm            Int?
  status         String   @default("IN_PROGRESS")
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduleMixing  ScheduleMixing @relation(fields: [scheduleMixingId], references: [id], onDelete: Cascade)
  batchRecord     BatchRecord    @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  items           ProductionMixingItem[]

  @@index([organizationId, status])
  @@map("production_mixings")
}

model ProductionMixingItem {
  id                  String  @id @default(uuid()) @db.Uuid
  productionMixingId  String  @db.Uuid
  goodsId             String  @db.Uuid
  concentration       Decimal @db.Decimal(8, 4) // %
  qtyTheoretical      Decimal @db.Decimal(18, 4)
  qtyActual           Decimal @db.Decimal(18, 4)
  note                String?

  productionMixing ProductionMixing @relation(fields: [productionMixingId], references: [id], onDelete: Cascade)
  goods            Goods            @relation(fields: [goodsId], references: [id], onDelete: Restrict)

  @@index([productionMixingId])
  @@map("production_mixing_items")
}

model ProductionFilling {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  scheduleFillingId String @db.Uuid
  batchRecordId  String   @db.Uuid
  date           DateTime @db.Date
  bulkUsed       Decimal? @db.Decimal(18, 4)
