model ProductionPackagingItem {
  id                    String  @id @default(uuid()) @db.Uuid
  productionPackagingId String  @db.Uuid
  goodsId               String  @db.Uuid
  qty                   Decimal @db.Decimal(18, 2)

  productionPackaging ProductionPackaging @relation(fields: [productionPackagingId], references: [id], onDelete: Cascade)
