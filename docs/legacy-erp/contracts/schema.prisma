  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adjustedBy  User        @relation("FormulationAdjuster", fields: [adjustedById], references: [id], onDelete: Restrict)

  @@index([formulationId])
  @@map("formulation_adjustments")
