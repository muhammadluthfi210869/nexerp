  status         String   @default("RECEIVED")
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder?  @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([salesOrderId])
  @@map("sales_down_payments")
}

model SalesOrder {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique // SO-YYYYMMDD-XXXX (Lampiran A)
  date           DateTime @db.Date
  customerId     String?  @db.Uuid
  category       String?
  brand          String?
  contractType   String?  // 'Jasa Maklon' | 'Jual Putus'
  totalAmount    Decimal  @default(0) @db.Decimal(18, 2)
  paid           Decimal  @default(0) @db.Decimal(18, 2)
  remaining      Decimal  @default(0) @db.Decimal(18, 2)
  status         String   @default("DRAFT") // DRAFT | DP_PAID | IN_PRODUCTION | QC_PASS | SHIPPED | CLOSED | CANCELLED
  ownerUserId    String   @db.Uuid
  deliveryGateStatus String @default("HELD") // HELD | RELEASED (FINANCIAL_DELIVERY_RELEASE, NFR-Finance §3.2)
  formulaLocked  Boolean  @default(false)
  formulationId  String?  @db.Uuid
  notes          String?
  legacyId       Int?     @unique
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner        User         @relation("SalesOrderOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  details      SalesOrderDetail[]
  approvals    SalesOrderApproval[]
  invoices     SalesInvoice[]
  downPayments SalesDownPayment[]
  returns      SalesReturn[]
  deliveries   DeliveryOut[]
  batches      BatchRecord[]

  @@index([organizationId, status])
  @@index([customerId])
  @@index([ownerUserId])
  @@map("sales_orders")
}

model SalesOrderDetail {
  id            String  @id @default(uuid()) @db.Uuid
  salesOrderId  String  @db.Uuid
  goodsId       String  @db.Uuid
  qty           Decimal @db.Decimal(18, 2)
  price         Decimal @db.Decimal(18, 2)
  discount      Decimal @default(0) @db.Decimal(18, 2) // nominal
  total         Decimal @db.Decimal(18, 2)
  notes         String?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  goods      Goods      @relation(fields: [goodsId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@index([goodsId])
  @@map("sales_order_details")
}

model SalesOrderApproval {
  id            String   @id @default(uuid()) @db.Uuid
  salesOrderId  String   @db.Uuid
  status        String   // 'PENDING' | 'APPROVED' | 'REJECTED'
  approverId    String   @db.Uuid
  notes         String?
  decidedAt     DateTime? @db.Timestamptz
  createdAt     DateTime @default(now()) @db.Timestamptz

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  approver   User       @relation("SalesOrderApprover", fields: [approverId], references: [id], onDelete: Restrict)

  @@index([salesOrderId])
  @@map("sales_order_approvals")
}

model SalesInvoice {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique // FJ-YYMM-XXXX
  date           DateTime @db.Date
  customerId     String   @db.Uuid
  salesOrderId   String?  @db.Uuid
  total          Decimal  @db.Decimal(18, 2)
  paid           Decimal  @default(0) @db.Decimal(18, 2)
  remaining      Decimal  @db.Decimal(18, 2)
  ppnAmount      Decimal? @db.Decimal(18, 2)
  makerUserId    String   @db.Uuid
  status         String   @default("DRAFT") // DRAFT | POSTED | PAID | PARTIAL | CANCELLED
  dueDate        DateTime? @db.Date
  notes          String?
  jobOrderRef    String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  maker        User        @relation("SalesInvoiceMaker", fields: [makerUserId], references: [id], onDelete: Restrict)
  details      SalesInvoiceDetail[]
  payments     SalesPayment[]
  returns      SalesReturn[]

  @@index([organizationId, status])
  @@index([customerId])
  @@map("sales_invoices")
}

model SalesInvoiceDetail {
  id             String  @id @default(uuid()) @db.Uuid
  salesInvoiceId String  @db.Uuid
  goodsId        String  @db.Uuid
  qty            Decimal @db.Decimal(18, 2)
  price          Decimal @db.Decimal(18, 2)
  discount       Decimal @default(0) @db.Decimal(18, 2)
  total          Decimal @db.Decimal(18, 2)

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  goods        Goods        @relation(fields: [goodsId], references: [id], onDelete: Restrict)

  @@index([salesInvoiceId])
  @@map("sales_invoice_details")
}

model SalesPayment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique // BPJ-YYMM-XXXX
  salesInvoiceId String?  @db.Uuid
  customerId     String   @db.Uuid
  date           DateTime @db.Date
  grandTotal     Decimal  @db.Decimal(18, 2)
  paid           Decimal  @db.Decimal(18, 2)
  remaining      Decimal  @db.Decimal(18, 2)
  bankAccountId  String?  @db.Uuid
  pph23Deducted  Decimal? @db.Decimal(18, 2)
  status         String   @default("DRAFT")
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesInvoice SalesInvoice? @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("sales_payments")
}

model SalesReturn {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique
  date           DateTime @db.Date
  salesInvoiceId String?  @db.Uuid
  salesOrderId   String?  @db.Uuid
  customerId     String   @db.Uuid
  total          Decimal  @db.Decimal(18, 2)
  status         String   @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED | COMPLETED
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesInvoice SalesInvoice? @relation(fields: [salesInvoiceId], references: [id], onDelete: SetNull)
  salesOrder   SalesOrder?  @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  details      SalesReturnDetail[]
  approvals    SalesReturnApproval[]
  returnsIn    SalesReturnIn[]

  @@index([organizationId, status])
  @@map("sales_returns")
}

model SalesReturnDetail {
  id            String  @id @default(uuid()) @db.Uuid
  salesReturnId String  @db.Uuid
  goodsId       String  @db.Uuid
  qty           Decimal @db.Decimal(18, 2)
  availableQty  Decimal @db.Decimal(18, 2)
  returnQty     Decimal @db.Decimal(18, 2)
  note          String?

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  goods       Goods       @relation(fields: [goodsId], references: [id], onDelete: Restrict)

  @@index([salesReturnId])
  @@map("sales_return_details")
}

model SalesReturnApproval {
  id            String   @id @default(uuid()) @db.Uuid
  salesReturnId String   @db.Uuid
  status        String
  approverId    String   @db.Uuid
  notes         String?
  decidedAt     DateTime? @db.Timestamptz
  createdAt     DateTime @default(now()) @db.Timestamptz

  salesReturn SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  approver    User        @relation("SalesReturnApprover", fields: [approverId], references: [id], onDelete: Restrict)

  @@index([salesReturnId])
  @@map("sales_return_approvals")
}

model SalesReturnIn {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique
  date           DateTime @db.Date
  salesReturnId  String   @db.Uuid
  customerId     String   @db.Uuid
  warehouseId    String?  @db.Uuid
  makerUserId    String   @db.Uuid
  status         String   @default("DRAFT")
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesReturn  SalesReturn  @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("sales_return_ins")
}

model SalesTarget {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  period         String   // 'YYYY-MM'
  marketingUserId String  @db.Uuid
  targetAmount   Decimal  @db.Decimal(18, 2)
  achievedAmount Decimal  @default(0) @db.Decimal(18, 2)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketingUser User         @relation("SalesTargetUser", fields: [marketingUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, period, marketingUserId])
  @@index([period])
  @@map("sales_targets")
}

// =============================================================================
// SECTION 4 — PURCHASE PIPELINE
// =============================================================================
// PR → PO → GR → DP → Invoice → Payment → Return
// =============================================================================

model PurchaseRequest {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique
  date           DateTime @db.Date
  requesterUserId String  @db.Uuid
  supplierId     String?  @db.Uuid
  status         String   @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED | CONVERTED
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester   User         @relation("PurchaseRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  supplier    Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  details     PurchaseRequestDetail[]
  approvals   PurchaseRequestApproval[]
  purchaseOrders PurchaseOrder[]

  @@index([organizationId, status])
  @@map("purchase_requests")
}

model PurchaseRequestDetail {
  id                 String  @id @default(uuid()) @db.Uuid
  purchaseRequestId  String  @db.Uuid
  goodsId            String  @db.Uuid
  qty                Decimal @db.Decimal(18, 2)
  targetWarehouseId  String? @db.Uuid
  date               DateTime? @db.Date
  note               String?

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  goods           Goods           @relation(fields: [goodsId], references: [id], onDelete: Restrict)
  targetWarehouse Warehouse?      @relation("PRTargetWarehouse", fields: [targetWarehouseId], references: [id], onDelete: SetNull)

  @@index([purchaseRequestId])
  @@map("purchase_request_details")
}

model PurchaseRequestApproval {
  id                String   @id @default(uuid()) @db.Uuid
  purchaseRequestId String   @db.Uuid
  status            String
  approverId        String   @db.Uuid
  notes             String?
  decidedAt         DateTime? @db.Timestamptz
  createdAt         DateTime @default(now()) @db.Timestamptz

  purchaseRequest PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  approver        User            @relation("PurchaseRequestApprover", fields: [approverId], references: [id], onDelete: Restrict)

  @@index([purchaseRequestId])
  @@map("purchase_request_approvals")
}

model PurchaseOrder {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique // PO-YYYYMMDD-XXXX
  date           DateTime @db.Date // read-only = today (REQUIREMENT §13 Poin 64)
  supplierId     String   @db.Uuid
  targetWarehouseId String? @db.Uuid
  top            Int?     // term of payment days
  total          Decimal  @db.Decimal(18, 2)
  discount       Decimal  @default(0) @db.Decimal(18, 2)
  ongkir         Decimal  @default(0) @db.Decimal(18, 2)
  status         String   @default("DRAFT") // DRAFT | PENDING | APPROVED | REJECTED | PARTIAL | CLOSED | CANCELLED
  notes          String?
  purchaseRequestId String? @db.Uuid
  legacyId       Int?     @unique
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier        Supplier        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  targetWarehouse Warehouse?      @relation(fields: [targetWarehouseId], references: [id], onDelete: SetNull)
  purchaseRequest PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  details         PurchaseOrderDetail[]
  approvals       PurchaseOrderApproval[]
  goodsReceipts   GoodsReceipt[]
  invoices        PurchaseInvoice[]
  downPayments    PurchaseDownPayment[]
  returns         PurchaseReturn[]

  @@index([organizationId, status])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderDetail {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @db.Uuid
  goodsId         String  @db.Uuid
  qty             Decimal @db.Decimal(18, 2)
