  stockOpname StockOpname @relation(fields: [stockOpnameId], references: [id], onDelete: Cascade)
  goods       Goods       @relation(fields: [goodsId], references: [id], onDelete: Restrict)

  @@index([stockOpnameId])
  @@map("stock_opname_details")
}

model StockAdjustment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique
  stockOpnameId  String?  @db.Uuid
  warehouseId    String   @db.Uuid
  date           DateTime @db.Date
  makerUserId    String   @db.Uuid
  status         String   @default("DRAFT")
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockOpname  StockOpname?  @relation(fields: [stockOpnameId], references: [id], onDelete: SetNull)
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  maker        User          @relation("StockAdjustmentMaker", fields: [makerUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("stock_adjustments")
}

// =============================================================================
// SECTION 7 — FINANCE / ACCOUNTING
// =============================================================================
// Per NEX_FINANCE_FINAL_SPEC.md + 09_NON_FUNCTIONAL_CONTRACT §3
// =============================================================================

model CashBank {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique
  name           String
  type           String   // 'CASH' | 'BANK' | 'PETTY_CASH'
  accountNumber  String?
  bankName       String?
  currency       String   @default("IDR")
  currentBalance Decimal @default(0) @db.Decimal(18, 2)
  glCoaId        String?  @db.Uuid
  isActive       Boolean  @default(true)
  legacyId       Int?     @unique
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  glCoa        Coa?         @relation("CashBankGlCoa", fields: [glCoaId], references: [id], onDelete: SetNull)
  suppliers    Supplier[]

  @@index([organizationId, isActive])
  @@map("cash_banks")
}

model JournalEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique // JU-YYMM-XXXX
  date           DateTime @db.Date
  description    String
  type           String   // 'MANUAL' | 'SAMPLE_INVOICE' | 'GOODS_RECEIPT' | 'STOCK_OPNAME' | 'ADJUSTMENT' | etc.
  reference      String?  // link to source document
  sourceEntityType String?
  sourceEntityId String?  @db.Uuid
  status         String   @default("DRAFT") // DRAFT | PENDING | APPROVED | POSTED | REVERSED
  makerUserId    String   @db.Uuid
  isAdjustment   Boolean  @default(false) // for hard-locked period
  lockedPeriod   String?  // 'YYYY-MM' if for locked period
  correlationId  String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  postedAt       DateTime? @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  maker        User          @relation("JournalMaker", fields: [makerUserId], references: [id], onDelete: Restrict)
  lines        JournalLine[]

  @@index([organizationId, status])
  @@index([date])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid()) @db.Uuid
  journalEntryId String   @db.Uuid
  coaId          String   @db.Uuid
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  note           String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  coa          Coa          @relation(fields: [coaId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([coaId])
  @@map("journal_lines")
}

model TaxSetup {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  type           String   // 'PPN' | 'PPH21' | 'PPH23' | 'PPH_FINAL'
  name           String
  rate           Decimal  @db.Decimal(8, 4) // e.g. 11.00 for PPN
  glCoaId        String?  @db.Uuid
  effectiveDate  DateTime @db.Date
  expiryDate     DateTime? @db.Date
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, effectiveDate])
  @@index([organizationId, isActive])
  @@map("tax_setups")
}

model FixedAsset {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique // AST-YYYYMMDD-XXXX (Lampiran A)
  name           String
  category       String   // 'INVENTARIS' | 'MOTOR' | 'MOBIL' | 'BANGUNAN_PERMANEN' | 'INTANGIBLE'
  acquisitionDate DateTime @db.Date
  acquisitionCost Decimal @db.Decimal(18, 2)
  usefulLife     Int      // years
  salvageValue   Decimal  @default(0) @db.Decimal(18, 2)
  accumulatedDepreciation Decimal @default(0) @db.Decimal(18, 2)
  bookValue      Decimal  @db.Decimal(18, 2)
  depreciationMethod String @default("STRAIGHT_LINE")
  location       String?
  department     String?
  sourceType     String?  // 'MANUAL' | 'PURCHASE_INVOICE'
  sourceInvoiceId String? @db.Uuid
  status         String   @default("ACTIVE") // ACTIVE | TRANSFERRED | DISPOSED
  legacyId       Int?     @unique
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([category])
  @@map("fixed_assets")
}

model Budget {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  period         String   // 'YYYY-MM'
  fiscalYear     Int
  department     String?
  coaId          String?  @db.Uuid
  amount         Decimal  @db.Decimal(18, 2)
  version        String   @default("DRAFT") // DRAFT | APPROVED
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period, department, coaId, version])
  @@index([organizationId, fiscalYear])
  @@map("budgets")
}

model FundRequest {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique
  requesterId    String   @db.Uuid
  department     String?
  purpose        String
  amount         Decimal  @db.Decimal(18, 2)
  neededDate     DateTime? @db.Date
  attachment     String?
  currentLevel   Int      @default(1) // 1=Head, 2=Accounting, 3=Director
  status         String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED | DISBURSED | CLOSED
  approverId     String?  @db.Uuid
  disburserId    String?  @db.Uuid
  disbursedAt    DateTime? @db.Timestamptz
  cashBankId     String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User         @relation("FundRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  approver     User?        @relation("FundApprover", fields: [approverId], references: [id], onDelete: SetNull)
  disburser    User?        @relation("FundDisburser", fields: [disburserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("fund_requests")
}

// =============================================================================
// SECTION 8 — CHECKLIST (17-stage QC + closing)
// =============================================================================

model ChecklistCategory {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @db.Uuid
  name             String
  order            Int
  daysPerCategory  Int?
  afterCategoryId  String?  @db.Uuid
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @updatedAt @db.Timestamptz
  deletedAt        DateTime? @db.Timestamptz

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  afterCategory   ChecklistCategory? @relation("ChecklistCategoryAfter", fields: [afterCategoryId], references: [id], onDelete: SetNull)
  nextCategories  ChecklistCategory[] @relation("ChecklistCategoryAfter")
  progresses      ChecklistProgress[]

  @@index([organizationId, order])
  @@map("checklist_categories")
}

model Checklist {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String?  @unique
  salesOrderId   String?  @db.Uuid
  customerId     String?  @db.Uuid
  productName    String
  startDate      DateTime @db.Date
  endDate        DateTime? @db.Date
  status         String   @default("OPEN") // OPEN | IN_PROGRESS | COMPLETED | CANCELLED
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  progresses   ChecklistProgress[]
  tracking     ChecklistTracking?

  @@index([organizationId, status])
  @@map("checklists")
}

model ChecklistProgress {
  id                  String   @id @default(uuid()) @db.Uuid
  checklistId         String   @db.Uuid
  checklistCategoryId String   @db.Uuid
  stageName           String
  status              String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | DONE | BLOCKED
  deadline            DateTime? @db.Date
  startedAt           DateTime? @db.Timestamptz
  completedAt         DateTime? @db.Timestamptz
  notes               String?
  evidence            String?
  approver            String?
  createdAt           DateTime @default(now()) @db.Timestamptz
  updatedAt           DateTime @updatedAt @db.Timestamptz

  checklist         Checklist         @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  checklistCategory ChecklistCategory @relation(fields: [checklistCategoryId], references: [id], onDelete: Restrict)

  @@index([checklistId])
  @@map("checklist_progresses")
}

model ChecklistTracking {
  id             String   @id @default(uuid()) @db.Uuid
  checklistId    String   @unique @db.Uuid
  currentStage   String?
  overallStatus  String   @default("OPEN")
  deadline       DateTime? @db.Date
  progressPct    Decimal  @default(0) @db.Decimal(5, 2)
  updatedAt      DateTime @updatedAt @db.Timestamptz

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@map("checklist_trackings")
}

// =============================================================================
// SECTION 9 — HR
// =============================================================================

model Employee {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  userId          String   @unique @db.Uuid
  divisionId      String?  @db.Uuid
  contractType    String?  // 'PERMANENT' | 'CONTRACT' | 'INTERN'
  contractEndDate DateTime? @db.Date
  managerUserId   String?  @db.Uuid
  laborGrade      String?
  joinDate        DateTime? @db.Date
  resignDate      DateTime? @db.Date
  status          String   @default("ACTIVE") // ACTIVE | RESIGNED | SUSPENDED
  baseSalary      Decimal? @db.Decimal(18, 2)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz
  deletedAt       DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  division     Division?    @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  contracts    EmployeeContract[]
  performances EmployeePerformance[]
  roleAssignments EmployeeRoleAssignment[]
  kpiResults    EmployeeKpiResult[]

  @@index([organizationId, status])
  @@map("employees")
}

model EmployeeContract {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @db.Uuid
  type        String   // 'PERMANENT' | 'CONTRACT' | 'INTERN' | 'PROBATION'
  startDate   DateTime @db.Date
  endDate     DateTime? @db.Date
  salary      Decimal  @db.Decimal(18, 2)
  status      String   @default("ACTIVE") // ACTIVE | EXPIRED | TERMINATED
  notes       String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([endDate])
  @@map("employee_contracts")
}

model EmployeePerformance {
  id          String   @id @default(uuid()) @db.Uuid
  employeeId  String   @db.Uuid
  period      String   // 'YYYY-MM' or 'YYYY-Qn'
  kpiScore    Decimal? @db.Decimal(5, 2)
  division    String?
  status      String   @default("DRAFT")
  notes       String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  results  EmployeeKpiResult[]

  @@unique([employeeId, period])
  @@index([employeeId, period])
  @@map("employee_performances")
}

model EmployeeRoleAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  employeeId     String   @db.Uuid
  roleId         String   @db.Uuid
  weight         Decimal  @db.Decimal(5, 2) // percentage; active weights per employee/period total 100
  validFrom      DateTime @db.Date
  validTo        DateTime? @db.Date
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([employeeId, roleId, validFrom])
  @@index([organizationId, employeeId, validFrom, validTo])
  @@map("employee_role_assignments")
}

model KpiDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String
  name           String
  division       String
  direction      String   // HIGHER_BETTER | LOWER_BETTER | ZERO_TARGET
  unit           String   // PERCENT | COUNT | HOURS | DAYS | IDR | SCORE
  targetValue    Decimal  @db.Decimal(18, 4)
  weight         Decimal  @db.Decimal(5, 2)
  formulaRuleId  String   // BUS-RULE-* canonical formula owner
  sourceEvent    String
  attributionKey String   // actor field used to credit the employee
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  results      EmployeeKpiResult[]

  @@unique([organizationId, key])
  @@index([organizationId, division, isActive])
  @@map("kpi_definitions")
}

model EmployeeKpiResult {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @db.Uuid
  employeeId            String   @db.Uuid
  kpiDefinitionId       String   @db.Uuid
  employeePerformanceId String?  @db.Uuid
  period                String   // YYYY-MM or YYYY-Qn
  numerator             Decimal? @db.Decimal(18, 4)
  denominator           Decimal? @db.Decimal(18, 4)
  value                 Decimal? @db.Decimal(18, 4)
  achievementScore      Decimal? @db.Decimal(7, 2)
  weightedScore         Decimal? @db.Decimal(7, 2)
  evidence              Json
  calculationVersion    Int      @default(1)
  calculatedAt          DateTime @default(now()) @db.Timestamptz
  finalizedAt           DateTime? @db.Timestamptz
  createdAt             DateTime @default(now()) @db.Timestamptz
  updatedAt             DateTime @updatedAt @db.Timestamptz

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  definition   KpiDefinition        @relation(fields: [kpiDefinitionId], references: [id], onDelete: Restrict)
  performance  EmployeePerformance? @relation(fields: [employeePerformanceId], references: [id], onDelete: SetNull)

  @@unique([employeeId, kpiDefinitionId, period, calculationVersion])
  @@index([organizationId, period])
  @@index([employeeId, period])
  @@map("employee_kpi_results")
}

// =============================================================================
// SECTION 10 — COMMUNICATION LAYER (per-entity)
// =============================================================================
// Per _SSOT_COMMUNICATION.md
// =============================================================================

model Note {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  entityType     String
  entityId       String   @db.Uuid
  authorId       String   @db.Uuid
  body           String   // markdown
  visibility     String   @default("ALL") // ALL | INTERNAL | ADMIN
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
  @@map("notes")
}

model StatusTransition {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  entityType     String
  entityId       String   @db.Uuid
  fromStatus     String
  toStatus       String
  fromUserId     String   @db.Uuid
  toUserId       String?  @db.Uuid
  toRoleId       String?  @db.Uuid
  notes          String?
  slaDeadline    DateTime? @db.Timestamptz
  acknowledgedAt DateTime? @db.Timestamptz
  createdAt      DateTime @default(now()) @db.Timestamptz

  fromUser User  @relation("TransitionFromUser", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser   User? @relation("TransitionToUser",   fields: [toUserId],   references: [id], onDelete: SetNull)
  toRole   Role? @relation("ToRole",             fields: [toRoleId],   references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([toUserId, acknowledgedAt])
  @@map("status_transitions")
}

model Tag {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  type           String   // 'USER' | 'ROLE' | 'DIVISION'
  targetId       String   @db.Uuid
  contextType    String   // 'NOTE' | 'COMMENT' | 'TRANSITION'
  contextId      String   @db.Uuid
  mentionedById  String   @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mentionedBy   User         @relation("TagMentioner", fields: [mentionedById], references: [id], onDelete: Restrict)

  @@index([type, targetId])
  @@index([contextType, contextId])
  @@map("tags")
}

model Comment {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  entityType         String
  entityId           String   @db.Uuid
  authorId           String   @db.Uuid
  body               String
  relatedEntityType  String?  // cross-reference (DEC-013)
  relatedEntityId    String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz
  deletedAt          DateTime? @db.Timestamptz

  author User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([relatedEntityType, relatedEntityId])
  @@map("comments")
}

model Attachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  entityType     String
  entityId       String   @db.Uuid
  filename       String
  mimeType       String
  sizeBytes      Int
  storageUrl     String   // Supabase Storage path
  uploaderId     String   @db.Uuid
  description    String?
  uploadedAt     DateTime @default(now()) @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploader     User         @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([organizationId])
  @@map("attachments")
}

model Notification {
  id              String   @id @default(uuid()) @db.Uuid
  recipientUserId String   @db.Uuid
  type            String   // 'MENTION' | 'APPROVAL_REQUEST' | 'SLA_WARNING' | 'SLA_BREACH' | 'STATUS_CHANGED' | 'SYSTEM'
  contextType     String?
  contextId       String?  @db.Uuid
  title           String
  body            String?
  readAt          DateTime? @db.Timestamptz
  createdAt       DateTime @default(now()) @db.Timestamptz

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

// =============================================================================
// END OF SCHEMA
// =============================================================================
