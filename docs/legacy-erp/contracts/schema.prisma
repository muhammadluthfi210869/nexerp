  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesSample  SalesSample  @relation(fields: [salesSampleId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@map("sales_sample_payments")
}

model SalesDownPayment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique // DPJ-YYMM-XXXX
  salesOrderId   String?  @db.Uuid
  customerId     String?  @db.Uuid
  category       String   // 'SAMPLE' | 'LEGALITAS' | 'PRODUKSI'
  date           DateTime @db.Date
