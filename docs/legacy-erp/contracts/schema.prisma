  owner        User         @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  details      LeadDetail[]

  @@index([organizationId, status])
  @@index([ownerUserId])
  @@map("leads")
}

model LeadDetail {
  id    String  @id @default(uuid()) @db.Uuid
  leadId String @db.Uuid
  userId String @db.Uuid
  qty   Decimal @db.Decimal(18, 2)
  note  String?

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([userId])
  @@map("lead_details")
}

model SalesSample {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique // auto (DEC-020)
  date           DateTime @db.Date
  customerId     String?  @db.Uuid
  productName    String
  rev            Int      @default(1)
  formulatorId   String?  @db.Uuid
  totalAmount    Decimal  @default(0) @db.Decimal(18, 2)
  status         String   @default("DRAFT") // DRAFT | SUBMITTED | IN_PROGRESS | APPROVED | REJECTED | CONVERTED
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  formulator   User?         @relation("SalesSampleFormulator", fields: [formulatorId], references: [id], onDelete: SetNull)
  approvals    SalesSampleApproval[]
  payments     SalesSamplePayment[]

  @@index([organizationId, status])
  @@index([customerId])
