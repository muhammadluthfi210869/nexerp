// =============================================================================
// SECTION 6 — WAREHOUSE / INVENTORY
// =============================================================================

model StockMovement {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @db.Uuid
  goodsId         String   @db.Uuid
  warehouseId     String   @db.Uuid
  type            String   // 'IN' | 'OUT' | 'TRANSFER' | 'ADJUSTMENT' | 'OPNAME'
  quality         String   @default("GOOD") // GOOD | REJECT | FREE
  availability    String   @default("QUARANTINE") // QUARANTINE | AVAILABLE | HOLD
  qty             Decimal  @db.Decimal(18, 2)
  sourceEntityType String? // 'GoodsReceipt' | 'SalesInvoice' | 'StockAdjustment' | 'DeliveryOut' | etc.
  sourceEntityId  String?  @db.Uuid
  date            DateTime @db.Timestamptz
  makerUserId     String   @db.Uuid
  batchNumber     String?
  expiryDate      DateTime? @db.Date
  notes           String?
  createdAt       DateTime @default(now()) @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goods        Goods        @relation(fields: [goodsId], references: [id], onDelete: Restrict)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  maker        User         @relation("StockMovementMaker", fields: [makerUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, goodsId, warehouseId, availability])
  @@index([sourceEntityType, sourceEntityId])
  @@index([date])
  @@map("stock_movements")
}

model StockOpname {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique
  date           DateTime @db.Date
  warehouseId    String   @db.Uuid
  note           String?
  status         String   @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | ADJUSTED
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  details      StockOpnameDetail[]
  adjustments  StockAdjustment[]

  @@index([organizationId, status])
  @@map("stock_opnames")
}

model StockOpnameDetail {
  id            String  @id @default(uuid()) @db.Uuid
  stockOpnameId String  @db.Uuid
  goodsId       String  @db.Uuid
  stockSystem   Decimal @db.Decimal(18, 2)
  stockActual   Decimal @db.Decimal(18, 2)
  variance      Decimal @db.Decimal(18, 2)
