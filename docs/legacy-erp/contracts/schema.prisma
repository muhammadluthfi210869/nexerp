  deletedAt      DateTime? @db.Timestamptz

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scheduleFilling ScheduleFilling @relation(fields: [scheduleFillingId], references: [id], onDelete: Cascade)
  batchRecord     BatchRecord     @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  items           ProductionFillingItem[]

  @@index([organizationId, status])
  @@map("production_fillings")
}

model ProductionFillingItem {
  id                  String  @id @default(uuid()) @db.Uuid
  productionFillingId String  @db.Uuid
  goodsId             String  @db.Uuid
  qty                 Decimal @db.Decimal(18, 2)
  reject              Int     @default(0)

  productionFilling ProductionFilling @relation(fields: [productionFillingId], references: [id], onDelete: Cascade)
  goods             Goods             @relation(fields: [goodsId], references: [id], onDelete: Restrict)

  @@index([productionFillingId])
  @@map("production_filling_items")
}

model ProductionPackaging {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  schedulePackagingId String @db.Uuid
  batchRecordId  String   @db.Uuid
  date           DateTime @db.Date
  bpomLabel      Boolean  @default(false)
  expiryDateInkjet DateTime? @db.Date
  status         String   @default("IN_PROGRESS")
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  schedulePackaging SchedulePackaging @relation(fields: [schedulePackagingId], references: [id], onDelete: Cascade)
  batchRecord       BatchRecord       @relation(fields: [batchRecordId], references: [id], onDelete: Cascade)
  items             ProductionPackagingItem[]

