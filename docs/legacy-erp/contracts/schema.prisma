  qtyFree        Decimal @db.Decimal(18, 2)
  qtyQcPassed    Decimal @default(0) @db.Decimal(18, 2) // for matching engine (NFR-Finance §2.2)
  batchNumber    String?
  expiryDate     DateTime? @db.Date
  coaVerified    Boolean @default(false)
  coaUrl         String?

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  goods        Goods        @relation(fields: [goodsId], references: [id], onDelete: Restrict)

  @@index([goodsReceiptId])
  @@map("goods_receipt_details")
}

model PurchaseInvoice {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique // FP-YYMM-XXXX (vendor's own number also kept)
  vendorInvoiceNo String?
  date           DateTime @db.Date // custom, NOT auto-today (REQUIREMENT Poin 4)
  dueDate        DateTime? @db.Date
  supplierId     String   @db.Uuid
  purchaseOrderId String? @db.Uuid
  goodsReceiptId String?  @db.Uuid
  total          Decimal  @db.Decimal(18, 2)
  paid           Decimal  @default(0) @db.Decimal(18, 2)
  remaining      Decimal  @db.Decimal(18, 2)
  ppnAmount      Decimal? @db.Decimal(18, 2)
  status         String   @default("DRAFT") // DRAFT | PENDING | APPROVED | POSTED | PAID | PARTIAL
  matchingStatus String?  // MATCHED | EXCEPTION (UI hides accuracy %, NFR-Finance §2.2)
  notes          String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  goodsReceipt  GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  details       PurchaseInvoiceDetail[]
  payments      PurchasePayment[]

  @@index([organizationId, status])
  @@map("purchase_invoices")
}

model PurchaseInvoiceDetail {
  id                String  @id @default(uuid()) @db.Uuid
  purchaseInvoiceId String  @db.Uuid
  goodsId           String  @db.Uuid
  qty               Decimal @db.Decimal(18, 2)
  price             Decimal @db.Decimal(18, 2)
  discount          Decimal @default(0) @db.Decimal(18, 2)
  total             Decimal @db.Decimal(18, 2)
  jobOrderRef       String?

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  goods           Goods           @relation(fields: [goodsId], references: [id], onDelete: Restrict)

