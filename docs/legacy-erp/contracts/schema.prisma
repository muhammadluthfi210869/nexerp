// Contract status: PROVISIONAL. Physical persistence owner per 00_MASTER_SPEC.md §9.1.
// =============================================================================
// NEX ERP — Domain Schema (Prisma + PostgreSQL 15)
// =============================================================================
// Project: NEX ERP — replacement for legacy `code.gserp.id` / `kil.gserp.id`
// Stack:   NestJS + Prisma 5+ + PostgreSQL 15
// Author:  Domain Model contract 01 (LOCKED)
// Source:  00_MASTER_SPEC.md, 09_NON_FUNCTIONAL_CONTRACT.md,
//          _SSOT_AUTH.md, _SSOT_COMMUNICATION.md,
//          NEX_ERP_MASTER_SPECIFICATION.md, NEX_FINANCE_FINAL_SPEC.md
//
// Conventions
//   • Model name = PascalCase singular (e.g. SalesOrder)
//   • DB table   = snake_case plural via @@map (e.g. sales_orders)
//   • All business entities have `organizationId` + `deletedAt` (soft-delete)
//   • UUID PK everywhere (DEC-025 — legacy IDs preserved in `legacyId`)
//   • Money columns: Decimal @db.Decimal(18, 2) (per NFR §3)
//   • Timestamps:    DateTime @db.Timestamptz (per NFR §2)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// SECTION 1 — AUTH & USER MANAGEMENT
// =============================================================================
// Per _SSOT_AUTH.md + NFR §6/§7
// =============================================================================

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  // Relations
  users              User[]
  roles              Role[]
  customerCategories CustomerCategory[]
  customers          Customer[]
  supplierCategories SupplierCategory[]
  suppliers          Supplier[]
  goodsCategories    GoodsCategory[]
  goods              Goods[]
  warehouses         Warehouse[]
  coa                Coa[]
  coaAuto            CoaAuto[]
  formulations       Formulation[]
  formulationAdjustments FormulationAdjustment[]
  leads              Lead[]
  salesSamples       SalesSample[]
  salesSamplePayments SalesSamplePayment[]
  salesDownPayments  SalesDownPayment[]
  salesOrders        SalesOrder[]
  salesInvoices      SalesInvoice[]
  salesPayments      SalesPayment[]
  salesReturns       SalesReturn[]
  salesReturnIns     SalesReturnIn[]
  salesTargets       SalesTarget[]
  purchaseRequests   PurchaseRequest[]
  purchaseOrders     PurchaseOrder[]
  purchaseDownPayments PurchaseDownPayment[]
  goodsReceipts      GoodsReceipt[]
  purchaseInvoices   PurchaseInvoice[]
  purchasePayments   PurchasePayment[]
  purchaseReturns    PurchaseReturn[]
  purchaseReturnOuts PurchaseReturnOut[]
  batchRecords       BatchRecord[]
  scheduleMixings    ScheduleMixing[]
  scheduleFillings   ScheduleFilling[]
  schedulePackagings SchedulePackaging[]
  productionMixings  ProductionMixing[]
  productionFillings ProductionFilling[]
  productionPackagings ProductionPackaging[]
  deliveryOuts       DeliveryOut[]
  stockMovements     StockMovement[]
  stockOpnames       StockOpname[]
  stockAdjustments   StockAdjustment[]
  journalEntries     JournalEntry[]
  cashBanks          CashBank[]
  taxSetups          TaxSetup[]
  fixedAssets        FixedAsset[]
  budgets            Budget[]
  fundRequests       FundRequest[]
  checklistCategories ChecklistCategory[]
  checklists         Checklist[]
  employees          Employee[]
  kpiDefinitions     KpiDefinition[]
  employeeKpiResults EmployeeKpiResult[]
  employeeRoleAssignments EmployeeRoleAssignment[]
  divisions          Division[]
  notes              Note[]
  tags               Tag[]
  attachments        Attachment[]

  @@map("organizations")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid // null = global/system role
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  legacyId       Int?     @unique // legacy role ID 1-16 (DEC-025)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  users          User[]
  permissions    RolePermission[]
  employeeAssignments EmployeeRoleAssignment[]
  approverTransitions StatusTransition[] @relation("ToRole")

  @@index([organizationId])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique // kebab-case (DEC-024): role-manage, sales, etc.
  module      String   // e.g. 'sales', 'purchase', 'production'
  action      String   // 'read' | 'create' | 'update' | 'delete' | 'approve' | 'export' | 'import'
  description String?
  category    String?  // 'sub-module' | 'dashboard' | 'special'
  createdAt   DateTime @default(now()) @db.Timestamptz

  roles       RolePermission[]

  @@index([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  email            String    @unique
  fullName         String
  employeeCode     String?   // NIP (legacy user.code)
  phone            String?
  avatarUrl        String?
  roleId           String    @db.Uuid
  isActive         Boolean   @default(true)
  joinedAt         DateTime? @db.Timestamptz
  lastLoginAt      DateTime? @db.Timestamptz
  mfaEnabled       Boolean   @default(false)
  mfaSecret        String?   // encrypted AES-256-GCM
  passwordHash     String    // bcrypt cost 12
  passwordChangedAt DateTime? @db.Timestamptz
  legacyId         Int?      @unique // legacy user.id (DEC-025)
  legacyRoleId     Int?
  createdAt        DateTime  @default(now()) @db.Timestamptz
  updatedAt        DateTime  @updatedAt @db.Timestamptz
  deletedAt        DateTime? @db.Timestamptz

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role              Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions          UserSession[]
  auditLogs         AuditLog[]        @relation("AuditActor")
  activityLogs      ActivityLog[]
  ledLeads          Lead[]            @relation("LeadOwner")
  leadDetails       LeadDetail[]
  salesSamples      SalesSample[]     @relation("SalesSampleFormulator")
  salesSampleApprovals SalesSampleApproval[] @relation("SalesSampleApprover")
  salesOrders       SalesOrder[]      @relation("SalesOrderOwner")
  salesOrderApprovals SalesOrderApproval[] @relation("SalesOrderApprover")
  salesInvoices     SalesInvoice[]    @relation("SalesInvoiceMaker")
  salesReturnApprovals SalesReturnApproval[] @relation("SalesReturnApprover")
  salesTargets      SalesTarget[]     @relation("SalesTargetUser")
  purchaseRequests  PurchaseRequest[] @relation("PurchaseRequester")
  purchaseRequestApprovals PurchaseRequestApproval[] @relation("PurchaseRequestApprover")
  purchaseOrderApprovals PurchaseOrderApproval[] @relation("PurchaseOrderApprover")
  goodsReceipts     GoodsReceipt[]    @relation("GoodsReceiptMaker")
  purchaseReturnApprovals PurchaseReturnApproval[] @relation("PurchaseReturnApprover")
  journalEntries    JournalEntry[]    @relation("JournalMaker")
  stockMovements    StockMovement[]   @relation("StockMovementMaker")
  stockAdjustments  StockAdjustment[] @relation("StockAdjustmentMaker")
  batchesMade       BatchRecord[]     @relation("BatchRecordMaker")
  scheduleMixings   ScheduleMixing[]  @relation("ScheduleMixingMaker")
  scheduleFillings  ScheduleFilling[] @relation("ScheduleFillingMaker")
  schedulePackagings SchedulePackaging[] @relation("SchedulePackagingMaker")
  deliveryOuts      DeliveryOut[]     @relation("DeliveryOutMaker")
  warehouseAccess   WarehouseAccess[]
  customerOwners    Customer[]        @relation("CustomerOwner")
  formulationAdjustments FormulationAdjustment[] @relation("FormulationAdjuster")
  authoredNotes     Note[]            @relation("NoteAuthor")
  authoredComments  Comment[]         @relation("CommentAuthor")
  uploadedFiles     Attachment[]      @relation("AttachmentUploader")
  notifications     Notification[]
  transitionsFrom   StatusTransition[] @relation("TransitionFromUser")
  transitionsTo     StatusTransition[] @relation("TransitionToUser")
  tagsCreated       Tag[]             @relation("TagMentioner")
  employee          Employee?
  createdFunds      FundRequest[]     @relation("FundRequester")
  approvedFunds     FundRequest[]     @relation("FundApprover")
  disbursedFunds    FundRequest[]     @relation("FundDisburser")

  @@index([organizationId, isActive])
  @@index([roleId])
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model UserSession {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  refreshTokenHash String   // SHA-256 of refresh token
  device           String?
  ip               String?  @db.Inet
  userAgent        String?
  expiresAt        DateTime @db.Timestamptz
  revokedAt        DateTime? @db.Timestamptz
  createdAt        DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  entityType    String
  entityId      String   @db.Uuid
  action        String   // 'create' | 'update' | 'delete' | 'status_change' | 'approve' | 'reject' | 'payment' | 'login' | 'logout' | 'permission_change'
  beforeState   Json?
  afterState    Json?
  changes       Json?
  actorId       String?  @db.Uuid
  actorRoleId   String?  @db.Uuid
  ipAddress     String?  @db.Inet
  userAgent     String?
  correlationId String?  @db.Uuid
  retentionTier String   @default("HOT") // HOT | COLD | PERMANENT
  createdAt     DateTime @default(now()) @db.Timestamptz

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([retentionTier])
  @@map("audit_logs")
}

// Legacy `activity-log` page (per _SSOT_AUTH §11.2) — separate from audit_logs
model ActivityLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @db.Uuid
  module    String
  action    String
  description String?
  ipAddress String?  @db.Inet
  createdAt DateTime @default(now()) @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("activity_logs")
}

// =============================================================================
// SECTION 2 — MASTER DATA
// =============================================================================

model Division {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String?
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]

  @@index([organizationId])
  @@map("divisions")
}

model CustomerCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customers    Customer[]

  @@index([organizationId])
  @@map("customer_categories")
}

model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  code           String    @unique // auto (DEC-020)
  name           String
  brandName      String?
  categoryId     String?   @db.Uuid
  contractType   String?   // 'Jasa Maklon' | 'Jual Putus' | null
  segmentation   String?   // 'Sample' | 'Produksi' | 'Legalitas' | combined CSV
  picName        String?
  picPhone       String?
  picEmail       String?
  phone          String?
  email          String?
  dateOfBirth    DateTime? @db.Date
  npwp           String?
  ownerUserId    String?   @db.Uuid
  province       String?
  city           String?
  address        String?
  creditLimit    Decimal?  @db.Decimal(18, 2)
  paymentTerm    Int?      // days
  defaultRevenueCoaId String? @db.Uuid
  isActive       Boolean   @default(true)
  legacyId       Int?      @unique
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     CustomerCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  owner        User?             @relation("CustomerOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  defaultRevenueCoa Coa?         @relation("CustomerDefaultRevenue", fields: [defaultRevenueCoaId], references: [id], onDelete: SetNull)

  leads            Lead[]
  salesSamples     SalesSample[]
  salesOrders      SalesOrder[]
  salesInvoices    SalesInvoice[]
  salesPayments    SalesPayment[]
  salesReturns     SalesReturn[]
  salesReturnIns   SalesReturnIn[]
  salesDownPayments SalesDownPayment[]
  salesSamplePayments SalesSamplePayment[]
  checklists       Checklist[]
  deliveryOuts     DeliveryOut[]

  @@index([organizationId, isActive])
  @@index([categoryId])
  @@index([ownerUserId])
  @@map("customers")
}

model SupplierCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String   // 4 pillars: Bahan Baku, Kemasan Primer, Kemasan Sekunder, Bahan Pembantu
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  suppliers    Supplier[]

  @@index([organizationId])
  @@map("supplier_categories")
}

model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique // auto (DEC-020)
  name           String
  categoryId     String?  @db.Uuid
  phone          String?
  pic            String?
  tax            String?  // NPWP
  npwp           String?
  pkpStatus      Boolean  @default(false)
  description    String?
  province       String?
  city           String?
  address        String?
  bankAccountId  String?  @db.Uuid
  paymentTerm    Int?     // days
  defaultCoaId   String?  @db.Uuid
  isActive       Boolean  @default(true)
  legacyId       Int?     @unique
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     SupplierCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bankAccount  CashBank?          @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  defaultCoa   Coa?               @relation("SupplierDefaultCoa", fields: [defaultCoaId], references: [id], onDelete: SetNull)

  purchaseOrders    PurchaseOrder[]
  purchaseRequests  PurchaseRequest[]
  goodsReceipts     GoodsReceipt[]
  purchaseInvoices  PurchaseInvoice[]
  purchasePayments  PurchasePayment[]
  purchaseReturns   PurchaseReturn[]
  purchaseReturnOuts PurchaseReturnOut[]
  purchaseDownPayments PurchaseDownPayment[]

  @@index([organizationId, isActive])
  @@index([categoryId])
  @@map("suppliers")
}

model GoodsCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  parentId       String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       GoodsCategory?  @relation("GoodsCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     GoodsCategory[] @relation("GoodsCategoryTree")
  goods        Goods[]

  @@index([organizationId])
  @@index([parentId])
  @@map("goods_categories")
}

model Goods {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique // auto (DEC-020)
  name           String
  categoryId     String?  @db.Uuid
  subCategory    String?
  unit           String   // pcs, kg, liter, etc.
  price          Decimal? @db.Decimal(18, 2)
  lowestStock    Decimal? @db.Decimal(18, 2)
  photoUrl       String?
  ownershipType  String   @default("OWNED_ASSET") // OWNED_ASSET | CUSTOMER_CONSIGNMENT (NFR §0.6)
  ownerCustomerId String?  @db.Uuid

  // 8 GL mappings (auto-journal)
  coa1Id String? @db.Uuid
  coa2Id String? @db.Uuid
  coa3Id String? @db.Uuid
  coa4Id String? @db.Uuid
  coa5Id String? @db.Uuid
  coa6Id String? @db.Uuid
  coa7Id String? @db.Uuid
  coa8Id String? @db.Uuid

  isActive       Boolean   @default(true)
  legacyId       Int?      @unique
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     GoodsCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  coa1 Coa? @relation("GoodsCoa1", fields: [coa1Id], references: [id], onDelete: SetNull)
  coa2 Coa? @relation("GoodsCoa2", fields: [coa2Id], references: [id], onDelete: SetNull)
  coa3 Coa? @relation("GoodsCoa3", fields: [coa3Id], references: [id], onDelete: SetNull)
  coa4 Coa? @relation("GoodsCoa4", fields: [coa4Id], references: [id], onDelete: SetNull)
  coa5 Coa? @relation("GoodsCoa5", fields: [coa5Id], references: [id], onDelete: SetNull)
  coa6 Coa? @relation("GoodsCoa6", fields: [coa6Id], references: [id], onDelete: SetNull)
  coa7 Coa? @relation("GoodsCoa7", fields: [coa7Id], references: [id], onDelete: SetNull)
  coa8 Coa? @relation("GoodsCoa8", fields: [coa8Id], references: [id], onDelete: SetNull)

  formulations            Formulation[]
  salesOrderDetails       SalesOrderDetail[]
  salesInvoiceDetails     SalesInvoiceDetail[]
  salesReturnDetails      SalesReturnDetail[]
  purchaseRequestDetails  PurchaseRequestDetail[]
  purchaseOrderDetails    PurchaseOrderDetail[]
  goodsReceiptDetails     GoodsReceiptDetail[]
  purchaseInvoiceDetails  PurchaseInvoiceDetail[]
  stockMovements          StockMovement[]
  stockOpnameDetails      StockOpnameDetail[]
  productionMixingItems   ProductionMixingItem[]
  productionFillingItems  ProductionFillingItem[]
  productionPackagingItems ProductionPackagingItem[]
  deliveryOutDetails      DeliveryOutDetail[]

  @@index([organizationId, isActive])
  @@index([categoryId])
  @@map("goods")
}

model Warehouse {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String?
  name           String
  phone          String?
  province       String?
  city           String?
  address        String?
  zone           String?  // 'KARANTINA' | 'RUAHAN' | 'FINISHED_GOODS'
  isActive       Boolean  @default(true)
  legacyId       Int?     @unique
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accesses       WarehouseAccess[]
  stockMovements StockMovement[]
  stockOpnames   StockOpname[]
  stockAdjustments StockAdjustment[]
  purchaseRequestTargetDetails PurchaseRequestDetail[] @relation("PRTargetWarehouse")
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  purchaseReturnOuts PurchaseReturnOut[]

  @@index([organizationId, isActive])
  @@map("warehouses")
}

model WarehouseAccess {
  userId      String @db.Uuid
  warehouseId String @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@index([warehouseId])
  @@map("warehouse_access")
}

model Coa {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   // 1xxx Asset, 2xxx Liability, dst (auto)
  name           String
  type           String   // 'ASSET' | 'LIABILITY' | 'EQUITY' | 'REVENUE' | 'EXPENSE'
  parentId       String?  @db.Uuid
  normalBalance  String   // 'DEBIT' | 'CREDIT'
  head           String?  // top-level group (e.g. '1xxx')
  allowManualJournal Boolean @default(false)
  isActive       Boolean  @default(true)
  legacyId       Int?     @unique
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent           Coa?         @relation("CoaTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Coa[]        @relation("CoaTree")
  journalLines     JournalLine[]
  customersDefault Customer[]   @relation("CustomerDefaultRevenue")
  suppliersDefault Supplier[]   @relation("SupplierDefaultCoa")
  goodsCoa1        Goods[]      @relation("GoodsCoa1")
  goodsCoa2        Goods[]      @relation("GoodsCoa2")
  goodsCoa3        Goods[]      @relation("GoodsCoa3")
  goodsCoa4        Goods[]      @relation("GoodsCoa4")
  goodsCoa5        Goods[]      @relation("GoodsCoa5")
  goodsCoa6        Goods[]      @relation("GoodsCoa6")
  goodsCoa7        Goods[]      @relation("GoodsCoa7")
  goodsCoa8        Goods[]      @relation("GoodsCoa8")
  coaAutoDebit1    CoaAuto[]    @relation("CoaAutoDebit1")
  coaAutoCredit1   CoaAuto[]    @relation("CoaAutoCredit1")
  coaAutoDebit2    CoaAuto[]    @relation("CoaAutoDebit2")
  coaAutoCredit2   CoaAuto[]    @relation("CoaAutoCredit2")
  coaAutoDebit3    CoaAuto[]    @relation("CoaAutoDebit3")
  coaAutoCredit3   CoaAuto[]    @relation("CoaAutoCredit3")
  coaAutoDebit4    CoaAuto[]    @relation("CoaAutoDebit4")
  coaAutoCredit4   CoaAuto[]    @relation("CoaAutoCredit4")
  coaAutoDebit5    CoaAuto[]    @relation("CoaAutoDebit5")
  coaAutoCredit5   CoaAuto[]    @relation("CoaAutoCredit5")
  coaAutoDebit6    CoaAuto[]    @relation("CoaAutoDebit6")
  coaAutoCredit6   CoaAuto[]    @relation("CoaAutoCredit6")
  cashBankGl       CashBank[]   @relation("CashBankGlCoa")

  @@unique([organizationId, code])
  @@index([organizationId, type])
  @@index([parentId])
  @@map("coa")
}

model CoaAuto {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  transactionEvent String // 'FP' | 'FJ' | 'DPB' | 'BPB' | 'DPJ' | 'BPJ' | 'KBM' | 'KBK' | 'JU' | dll
  description    String?

  // 12 auto-journal mapping slots (debit + credit pairs)
  coa1DebitId   String? @db.Uuid
  coa1CreditId  String? @db.Uuid
  coa2DebitId   String? @db.Uuid
  coa2CreditId  String? @db.Uuid
  coa3DebitId   String? @db.Uuid
  coa3CreditId  String? @db.Uuid
  coa4DebitId   String? @db.Uuid
  coa4CreditId  String? @db.Uuid
  coa5DebitId   String? @db.Uuid
  coa5CreditId  String? @db.Uuid
  coa6DebitId   String? @db.Uuid
  coa6CreditId  String? @db.Uuid
  coa7DebitId   String? @db.Uuid
  coa7CreditId  String? @db.Uuid
  coa8DebitId   String? @db.Uuid
  coa8CreditId  String? @db.Uuid
  coa9DebitId   String? @db.Uuid
  coa9CreditId  String? @db.Uuid
  coa10DebitId  String? @db.Uuid
  coa10CreditId String? @db.Uuid
  coa11DebitId  String? @db.Uuid
  coa11CreditId String? @db.Uuid
  coa12DebitId  String? @db.Uuid
  coa12CreditId String? @db.Uuid

  isActive       Boolean   @default(true)
