// =============================================================================
// SECTION 3 — SALES PIPELINE
// =============================================================================
// Leads → Sample → SO → DP → Invoice → Payment → Return
// =============================================================================

model Lead {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String?  @unique
  date           DateTime @db.Date
  customerId     String?  @db.Uuid
  note           String?
  totalQty       Decimal  @default(0) @db.Decimal(18, 2)
  ownerUserId    String   @db.Uuid
  status         String   @default("NEW_LEAD") // NEW_LEAD | CONTACTED | SAMPLE | WON | LOST
  lostReason     String?
  source         String?
  productInterest String?
  estimatedValue Decimal? @db.Decimal(18, 2)
  isRepeatOrder  Boolean  @default(false)
  province       String?
  city           String?
  address        String?
  firstFollowUpAt DateTime? @db.Timestamptz
  lastFollowUpAt DateTime? @db.Timestamptz
  convertedAt    DateTime? @db.Timestamptz
  legacyId       Int?     @unique
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz
  deletedAt      DateTime? @db.Timestamptz

