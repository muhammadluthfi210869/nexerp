  @@index([salesSampleId])
  @@map("sales_sample_approvals")
}

model SalesSamplePayment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  code           String   @unique // BSP-YYMM-XXXX (Lampiran A)
  salesSampleId  String   @db.Uuid
  customerId     String?  @db.Uuid
  date           DateTime @db.Date
  amount         Decimal  @db.Decimal(18, 2)
  bankAccountId  String?  @db.Uuid
  notes          String?
  status         String   @default("RECEIVED") // RECEIVED | OFFSET | EXPIRED
  offsetToDpId   String?  @db.Uuid
  validityPeriod DateTime? @db.Date
