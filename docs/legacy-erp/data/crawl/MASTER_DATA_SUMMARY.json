  "cross_references": [
    {"from": "customer", "field": "category", "to": "customer_category", "fk_pattern": "category_id → id"},
    {"from": "customer", "field": "user", "to": "user", "fk_pattern": "user_id → id (BusDev owner)"},
    {"from": "supplier", "field": "category", "to": "supplier_category", "fk_pattern": "category_id → id"},
    {"from": "goods", "field": "category", "to": "goods_category", "fk_pattern": "category_id → id"},
    {"from": "goods", "field": "sub_category", "to": "static map (no FK table)", "note": "sub_category values are hardcoded in JS, not a DB table"},
    {"from": "goods", "field": "unit", "to": "static (pcs/gr/ml)", "note": "static options"},
    {"from": "goods", "field": "coa_1..coa_8", "to": "coa", "fk_pattern": "each COA slot maps a transaction category to a default GL account"},
    {"from": "user", "field": "role", "to": "role", "fk_pattern": "role_id → id"},
    {"from": "warehouse_access", "field": "user+warehouse", "to": "user+warehouse", "fk_pattern": "M:N junction table, configured per-user warehouse access"},
    {"from": "role", "field": "module[]", "to": "side_menu", "fk_pattern": "module_id format {module}_{menuId}, hierarchical (1001, 1101, 1201 groups)"},
    {"from": "coa", "field": "parent", "to": "coa", "fk_pattern": "self-referential tree, head=true marks non-posting header"},
    {"from": "formulation", "field": "(parent)", "to": "goods", "fk_pattern": "parent_goods_id in URL, formulation is child of a product master"}
  ],

  "ajax_endpoint_pattern": "{module}/detail?id={id} for inline-edit modals; {module}/cities?province={id} for province→city cascade; {module}/coa for COA filter; role-manage/detail?id={id} returns menu tree with checked flags.",

  "ui_framework": "AdminLTE 3 + Bootstrap 4 + jQuery, plugins: select2, datetimepicker (tempusdominus), daterangepicker, summernote, ekko-lightbox, fullcalendar, overlayScrollbars. CSRF: hidden csrf_gs input present in all POST forms (CI3/CI4 standard).",

  "validation_observations": [
    "All POST forms include csrf_gs hidden field.",
    "select2 used for most selects — controlled dropdowns with data-placeholder='Pilih X'.",
    "Province→City is AJAX-driven across all master forms that have location.",
    "Goods.create has 8 separate COA selectors (coa_1..coa_8) — one per transaction GL bucket.",
    "User.create has password + password_confirm — client-side equality check standard.",
    "COA.create has 'head' checkbox — header accounts cannot receive postings."
  ],

