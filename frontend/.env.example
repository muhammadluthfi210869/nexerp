# API
NEXT_PUBLIC_API_URL="http://localhost:3002"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Auth (must match backend JWT_SECRET)
JWT_SECRET="change-this-to-a-random-secret"

# Database (direct queries from server components)
DATABASE_URL="postgresql://postgres:password@localhost:5432/erp_db?schema=public"

# ═══ PROTOTYPE MODE ═══════════════════════════════════════════════
# true  → frontend-only demo: login superadmin@nexerp.id / password123,
#         semua data = contoh (mock-data.ts), TANPA backend & database.
#         Cukup: cd frontend && npm run dev
# false / hapus → mode normal (pakai backend API).
NEXT_PUBLIC_PROTOTYPE_MODE="false"
